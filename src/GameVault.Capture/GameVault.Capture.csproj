<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0-windows</TargetFramework>
  <PlatformTarget>x64</PlatformTarget>
  <Platforms>x64</Platforms>
 </PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="../GameVault.Infrastructure/GameVault.Infrastructure.csproj" />
  <PackageReference Include="ScreenRecorderLib" Version="[7.0.1]" GeneratePathProperty="true" ExcludeAssets="build" />
  <!-- Vendor build targets reject solution AnyCPU. Select the supported x64 binary explicitly. -->
  <Reference Include="ScreenRecorderLib">
   <HintPath>$(PkgScreenRecorderLib)/build/x64/ScreenRecorderLib.dll</HintPath>
   <Private>true</Private>
  </Reference>
 </ItemGroup>
</Project>
