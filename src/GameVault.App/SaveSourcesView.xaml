<UserControl x:Class="GameVault.App.SaveSourcesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid MinHeight="640" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,16"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh discovery" Click="RefreshSources" Margin="12,0,0,0"/><StackPanel><TextBlock x:Name="Heading" Text="Save sources" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Find saves where the game writes them. Original files stay in place." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel>
 <StackPanel Grid.Row="1" Margin="0,0,0,14"><TextBlock x:Name="Summary" Text="Checking save locations…" FontSize="17" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="CheckedAt" Foreground="{DynamicResource AppMuted}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="Finding a source alone does not protect a save. Check Save backups in the library for the last verified copy." Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 <WrapPanel Grid.Row="2" Margin="0,0,0,12"><CheckBox x:Name="Automatic" Content="Automatic discovery" Checked="AutomaticChanged" Unchecked="AutomaticChanged" Margin="0,0,20,8"/><CheckBox x:Name="ShowPending" Content="Show all pending candidates" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,0,0,8"/></WrapPanel>
 <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="Sources" SelectionChanged="SourceSelected" Background="{DynamicResource AppSurface}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Save source candidates"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,6"><TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding State}" Foreground="{DynamicResource AppAccent}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyNotice" Text="No readable candidates yet. Discovery will retry during play. Use Edit game for a manual override if needed." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Visibility="Collapsed"/>
 <StackPanel Grid.Row="1" Margin="0,10,0,0"><TextBox x:Name="Diagnostics" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppWarning}" AutomationProperties.Name="Discovery warnings"/><WrapPanel Margin="0,10,0,0"><Button x:Name="ConfirmButton" Content="Confirm this source" Style="{StaticResource PrimaryButton}" Click="ConfirmSource" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="ManualButton" Content="Edit manual locations…" Click="EditManual" Margin="0,0,0,8"/></WrapPanel></StackPanel></Grid>

 </Grid></ScrollViewer>
 <DockPanel Grid.Row="1" Margin="0,12,0,0"><Button x:Name="BackButton" DockPanel.Dock="Right" Content="Back to game" Click="Back"/><TextBlock x:Name="ActionNotice" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </Grid>
</UserControl>
