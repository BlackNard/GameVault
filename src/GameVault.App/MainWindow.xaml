<Window x:Class="GameVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameVault — Foundation build"
        Width="800" Height="480" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="Segoe UI" FontSize="15">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="GameVault" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Foundation build" FontSize="20" Margin="0,8,0,20" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,24"
                       Text="The Windows starter app is running. Your game library, playtime tracking, and save backups will be added in the next development steps." />
            <TextBlock Text="Future game profiles" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox Text="{Binding Profiles, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="Wrap" BorderThickness="0" Padding="0,6"
                     Background="Transparent" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                     AutomationProperties.Name="Future game profiles folder" />
            <TextBlock TextWrapping="Wrap" Margin="0,20,0,0"
                       Text="This build checks that its folder is writable and protects it from a second running instance. No game profiles or save backups are created yet." />
        </StackPanel>
    </ScrollViewer>
</Window>
