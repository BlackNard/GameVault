<Window x:Class="GameVault.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameVault.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="GameVault" Width="1280" Height="850" MinWidth="900" MinHeight="620" WindowState="Maximized" Icon="Assets/GameVault.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Window.Resources>
 <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource AppChrome}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionFrame" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppRaised}"/></Trigger>
   <Trigger Property="local:WindowChromeBehavior.IsNativeMouseOver" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppRaised}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppLine}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource AppDisabledOpacity}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource AppChrome}"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False" Data="M 1 6 L 11 6"/></Button>
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" x:Name="MaximizeCaptionButton" Click="MaximizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 2 2 L 10 2 L 10 10 L 2 10 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 3 1 L 11 1 L 11 9 M 1 3 L 9 3 L 9 11 L 1 11 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Close window" AutomationProperties.Name="Close window" Click="CloseWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False" Data="M 2 2 L 10 10 M 10 2 L 2 10"/></Button>
   </StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="20,0,0,0" VerticalAlignment="Center" LastChildFill="True" ClipToBounds="True"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image Source="Assets/GameVault.ico" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="GameVault" FontWeight="SemiBold" Margin="0,0,14,0"/>
     <Button x:Name="NavBackButton" Style="{StaticResource TitleIconButton}" Click="NavBackClicked" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" IsEnabled="False" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}" IsHitTestVisible="False" Data="M 8 1 L 3 6 L 8 11"/></Button>
     <Button x:Name="NavForwardButton" Style="{StaticResource TitleIconButton}" Click="NavForwardClicked" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" IsEnabled="False" Margin="2,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}" IsHitTestVisible="False" Data="M 4 1 L 9 6 L 4 11"/></Button>
     </StackPanel><TextBlock x:Name="BreadcrumbText" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
    <Button x:Name="PaletteButton" Grid.Column="1" Style="{StaticResource TitlePillButton}" Width="380" Click="OpenPaletteClicked" ToolTip="Search games or run a command (Ctrl+K)" AutomationProperties.Name="Search games or run a command" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Background="{DynamicResource AppRaised}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"><TextBlock Text="Ctrl K" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}"/></Border>
      <Path DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="{x:Null}" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 6 1 A 5 5 0 1 0 6 11 A 5 5 0 1 0 6 1 M 10 10 L 13.5 13.5"/>
      <TextBlock Text="Search games or run a command" TextTrimming="CharacterEllipsis"/></DockPanel></Button>
    <Button x:Name="NowPlayingButton" Grid.Column="2" Style="{StaticResource TitlePillButton}" HorizontalAlignment="Right" Margin="0,0,14,0" Visibility="Collapsed" Click="NowPlayingClicked" ToolTip="Open the running game" AutomationProperties.Name="Running game" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#8fe0b0" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="NowPlayingText" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
   </Grid>
  </DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource AppChrome}"><DockPanel Margin="12,24,12,16">
    <StackPanel DockPanel.Dock="Bottom"><Button x:Name="TrayAlertsButton" Content="Backup alerts" Click="ReviewNextAlert" Visibility="Collapsed" Margin="0,0,0,8"/><Button x:Name="SettingsNav" Background="Transparent" BorderThickness="0" Content="Settings" Click="ShowSettings" HorizontalContentAlignment="Left"/><Button x:Name="QuitButton" Background="Transparent" BorderThickness="0" Content="Quit GameVault" Click="QuitClicked" HorizontalContentAlignment="Left" Margin="0,8,0,0"/></StackPanel>
    <StackPanel><Button x:Name="LibraryNav" Background="Transparent" BorderThickness="0" Content="Library" Click="ShowLibrary" HorizontalContentAlignment="Left"/></StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="32,24,32,16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="LibraryPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,24"><Button x:Name="AddButton" Height="40" VerticalAlignment="Center" DockPanel.Dock="Right" Content="+ Add game" Style="{StaticResource PrimaryButton}" Click="AddGame"/><StackPanel><TextBlock Text="Library" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySummary" Text="Loading your games…" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><Label Content="Search games" Target="{Binding ElementName=Search}"/><TextBox x:Name="Search" TextChanged="FilterChanged" AutomationProperties.Name="Search games" ToolTip="Search your library by game name"/></StackPanel>
      <Expander Grid.Column="1" Header="Filter games" VerticalAlignment="Bottom"><StackPanel Width="200" Margin="0,12,0,0"><ComboBox x:Name="StatusFilter" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Game status"><ComboBoxItem Content="All statuses" Tag="All"/><ComboBoxItem Content="Not started" Tag="NotStarted"/><ComboBoxItem Content="Playing" Tag="Playing"/><ComboBoxItem Content="Completed" Tag="Completed"/><ComboBoxItem Content="On hold" Tag="OnHold"/></ComboBox><CheckBox x:Name="RemovedFilter" Content="Removed games" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,12,0,0"/></StackPanel></Expander>
     </Grid>
     <Grid Grid.Row="2"><ListBox x:Name="GameList" SelectionChanged="SelectedGameChanged" PreviewKeyDown="LibraryKeyDown" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Game library">
      <ListBox.ItemsPanel><ItemsPanelTemplate><local:VirtualizingCoverPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Button Click="OpenGameCard" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding Name}"><StackPanel Loaded="CoverRowLoaded" Unloaded="CoverRowUnloaded" DataContextChanged="CoverRowChanged"><Border Height="276" CornerRadius="8" Background="{DynamicResource AppSurface}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Initial}" FontSize="48" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,12,0,4" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Played}" Foreground="{DynamicResource AppMuted}"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource AppMuted}"/></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
     </ListBox><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Visibility="Collapsed"><TextBlock x:Name="EmptyHeading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/></StackPanel></Grid>
    </Grid>
    <Grid x:Name="GamePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><Button Content="‹  Library" Click="BackToLibrary" HorizontalAlignment="Left" Margin="-12,0,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="96" Height="144" Background="{DynamicResource AppSurface}" CornerRadius="6" ClipToBounds="True"><Image x:Name="GameHeroCover" Stretch="Uniform"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="DetailTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailState" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,8,0,16"/><WrapPanel><Button x:Name="PlayButton" Content="Play" Width="140" Style="{StaticResource PrimaryButton}" Click="PlayGame"/><Button x:Name="GameOptionsButton" Content="Game options" Click="ToggleGameOptions" Margin="16,0,0,0"/><Popup x:Name="GameOptionsPopup" PlacementTarget="{Binding ElementName=GameOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="False"><Border Background="{DynamicResource AppChrome}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" Padding="8"><StackPanel MinWidth="210"><Button x:Name="EditButton" Content="Edit game" Click="EditGame"/><Button x:Name="LaunchSettingsButton" Content="Launch settings" Click="ConfigureLaunch"/><Button x:Name="ArchiveButton" Content="Remove from library" Click="ArchiveGame"/></StackPanel></Border></Popup></WrapPanel></StackPanel></Grid><TextBlock x:Name="LaunchNotice" Foreground="{DynamicResource AppAccent}" Margin="0,14,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
     <WrapPanel Grid.Row="1" Margin="0,24,0,24"><Button x:Name="OverviewTab" Content="Overview" Tag="Overview" Click="GameTabClicked" Margin="0,0,8,0"/><Button x:Name="NotesButton" Content="Sessions &amp; notes" Tag="Sessions" Click="GameTabClicked" Margin="0,0,8,0"/><Button x:Name="SavesTab" Content="Saves" Tag="Saves" Click="GameTabClicked" Margin="0,0,8,0"/><Button x:Name="MediaTab" Content="Media" Tag="Media" Click="GameTabClicked"/></WrapPanel>
     <Grid Grid.Row="2"><ScrollViewer x:Name="DetailFields" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <StackPanel x:Name="OverviewSection"><WrapPanel Margin="0,0,0,32"><StackPanel Margin="0,0,56,0"><TextBlock Text="Total playtime" Foreground="{DynamicResource AppMuted}"/><TextBlock x:Name="DetailTime" FontSize="24" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="Latest session" Foreground="{DynamicResource AppMuted}"/><TextBlock x:Name="SessionElapsed" FontSize="20" Margin="0,6,0,0"/></StackPanel></WrapPanel><TextBlock x:Name="SessionWarning" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap"/><TextBlock Text="Save backup status" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="{Binding Text, ElementName=BackupNotice}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><Button Content="View backups and resolve issues" Tag="Saves" Click="GameTabClicked" HorizontalAlignment="Left" Margin="0,12,0,24"/><TextBlock Text="Your game, at a glance" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,16"/><TextBlock Text="Open Sessions &amp; notes to see individual play sessions, write notes or export your journal. Saves contains your backup history and restore options." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel x:Name="SavesSection" Visibility="Collapsed" MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="Save backups" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BackupNotice" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,8"/><TextBlock x:Name="LastBackup" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,0,0,16"/><WrapPanel><Button x:Name="BackupButton" Content="Back up now" Click="BackUpNow" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button x:Name="BackupHistoryButton" Content="Backup history" Click="OpenBackupHistory" Margin="0,0,12,8"/><Button Content="Open backup folder" Click="OpenBackupDirectory" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Backup destination" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="GameBackupLocation" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"/><WrapPanel Margin="0,12,0,24"><Button Content="Choose game backup folder" Click="ChooseGameBackupDirectory" Margin="0,0,12,0"/><Button Content="Use default location" Click="ResetGameBackupDirectory"/></WrapPanel><TextBlock Text="Live save locations" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DetailSaves" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,16"/><Button x:Name="SaveSourcesButton" Content="Manage save sources" Click="OpenSaveSources" HorizontalAlignment="Left"/><Expander Header="Game file locations" Margin="0,24,0,0"><StackPanel><Label Content="Executable"/><TextBox x:Name="DetailExecutable" IsReadOnly="True" TextWrapping="Wrap"/><Label Content="Working directory"/><TextBox x:Name="DetailWorking" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel>
      <StackPanel x:Name="MediaSection" Visibility="Collapsed"><local:CaptureControls x:Name="GameCaptureControls" Margin="0,0,0,20"/><Expander x:Name="CaptureMediaExpander" Header="Screenshots and recordings" Expanded="CaptureMediaExpanded" IsExpanded="True"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="CaptureMediaNotice" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><ListBox x:Name="CaptureMediaList" MaxHeight="350" SelectionChanged="CaptureMediaSelected" Margin="0,16,0,12" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/><Button x:Name="OpenCaptureMediaButton" Content="Open selected capture" IsEnabled="False" Click="OpenCaptureMedia" HorizontalAlignment="Left"/></StackPanel></Expander></StackPanel>
     </StackPanel></ScrollViewer><ContentControl x:Name="NotesHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Grid>
    </Grid>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,28"/><TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><Label Content="Color theme" Target="{Binding ElementName=ThemeChoice}"/><ComboBox x:Name="ThemeChoice" Width="260" HorizontalAlignment="Left" SelectionChanged="ThemeChanged"><ComboBoxItem Tag="Midnight" Content="Midnight (default)"/><ComboBoxItem Tag="Crimson" Content="Crimson (red and black)"/></ComboBox><TextBlock Text="Backup storage" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12"/><TextBlock Text="Choose the default destination for future backups. Existing snapshots stay available in their original folders." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><TextBlock x:Name="DefaultBackupLocation" TextWrapping="Wrap" Margin="0,12,0,12"/><WrapPanel><Button Content="Choose default backup folder" Click="ChooseDefaultBackupDirectory" Margin="0,0,12,0"/><Button Content="Use portable profile folders" Click="ResetDefaultBackupDirectory"/></WrapPanel><TextBlock Text="Background behavior" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12"/><CheckBox x:Name="CloseToTrayChoice" Content="Keep tracking in the tray when the window closes" Checked="TrayPreferencesChanged" Unchecked="TrayPreferencesChanged" Margin="0,0,0,12"/><CheckBox x:Name="BackupNotificationsChoice" Content="Notify me when a backup needs attention" Checked="TrayPreferencesChanged" Unchecked="TrayPreferencesChanged"/><local:CaptureSettingsView x:Name="CaptureSettings" Margin="0,32,0,16"/><Expander Header="Local profile storage" Margin="0,12,0,16"><TextBlock x:Name="ProfilesPath" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/></Expander></StackPanel></ScrollViewer>
    <ContentControl x:Name="EditorHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock x:Name="OperationNotice" Visibility="Collapsed" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><TextBlock x:Name="StorageNotice" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   </Grid>
  </Grid>
  <!-- Command palette (Ctrl+K) -->
  <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
   <Border Background="#B0060A10" MouseDown="PaletteScrimClicked"/>
   <Border VerticalAlignment="Top" HorizontalAlignment="Center" Width="640" Margin="0,84,0,0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="14">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Margin="12"><TextBox x:Name="PaletteInput" FontSize="16" Height="44" Padding="12,0" VerticalContentAlignment="Center" TextChanged="PaletteInputChanged" PreviewKeyDown="PaletteInputKeyDown" AutomationProperties.Name="Search games or run a command"/>
      <TextBlock Text="Type a game name or a command…" FontSize="16" Foreground="{DynamicResource AppMuted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PaletteInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <TextBlock x:Name="PaletteEmpty" DockPanel.Dock="Bottom" Text="No match. Try a game name or a command such as Settings." Foreground="{DynamicResource AppMuted}" Margin="20,4,20,16" Visibility="Collapsed"/>
     <TextBlock DockPanel.Dock="Bottom" Text="Up and Down to move · Enter to run · Esc to close" FontSize="12" Foreground="{DynamicResource AppMuted}" Margin="20,0,20,12"/>
     <ListBox x:Name="PaletteList" MaxHeight="360" Margin="8,0,8,4" BorderThickness="0" Background="Transparent" PreviewMouseLeftButtonUp="PaletteListClicked" AutomationProperties.Name="Results">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Group}" Foreground="{DynamicResource AppMuted}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>
  <!-- Toasts -->
  <ItemsControl x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="380" Margin="0,0,24,24" Panel.ZIndex="40" Focusable="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Notifications">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="12" Background="{DynamicResource AppRaised}" BorderThickness="1">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AppWarning}"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Width="26" Height="26" MinHeight="26" VerticalAlignment="Top" Tag="{Binding Id}" Click="DismissToast" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification"><Path Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" IsHitTestVisible="False" Data="M 1 1 L 8 8 M 8 1 L 1 8"/></Button>
      <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Visibility="{Binding ActionVisibility}" Tag="{Binding Id}" Click="ToastActionClicked" Margin="8,0,4,0" VerticalAlignment="Top" Height="28" MinHeight="28" Padding="10,0"/>
      <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
     </DockPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </Grid>
</Window>
