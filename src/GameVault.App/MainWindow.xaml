           <Button x:Name="OpenFolderButton" Style="{StaticResource HeroIconButton}" Click="OpenInstallFolderClicked" Margin="0,0,8,0" ToolTip="Open install folder" AutomationProperties.Name="Open install folder"><Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 1 4 L 6 4 L 8 6 L 15 6 L 15 14 L 1 14 Z"/></Button>
           <Button x:Name="HeroBackupButton" Style="{StaticResource HeroIconButton}" Click="BackUpNow" IsEnabled="{Binding IsEnabled, ElementName=BackupButton}" Margin="0,0,8,0" ToolTip="Back up saves now" AutomationProperties.Name="Back up saves now"><Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 8 1 L 14 3.5 L 14 8 C 14 11.5 11.5 13.5 8 15 C 4.5 13.5 2 11.5 2 8 L 2 3.5 Z M 5.5 8 L 7.3 9.8 L 10.6 6.4"/></Button>
           <Button x:Name="GameOptionsButton" Style="{StaticResource HeroIconButton}" Click="ToggleGameOptions" ToolTip="More options" AutomationProperties.Name="More options"><Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 2.5 8 L 2.51 8 M 8 8 L 8.01 8 M 13.5 8 L 13.51 8"/></Button>
           <Popup x:Name="GameOptionsPopup" PlacementTarget="{Binding ElementName=GameOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="False"><Border Background="{DynamicResource AppChrome}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" Padding="8" CornerRadius="10"><StackPanel MinWidth="210"><Button x:Name="LaunchSettingsButton" Content="Launch settings" Click="ConfigureLaunch" Margin="0,0,0,6"/><Button x:Name="ArchiveButton" Content="Remove from library" Click="ArchiveGame"/></StackPanel></Border></Popup></WrapPanel></StackPanel></Grid>
       </Grid>
      </Border>
      <TextBlock x:Name="LaunchNotice" Foreground="{DynamicResource AppAccent}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
