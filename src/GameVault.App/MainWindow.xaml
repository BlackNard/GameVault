        <MenuItem Header="Play" Click="MenuPlayClicked"/><MenuItem Header="Back up now" Click="MenuBackUpClicked"/><MenuItem Header="Open install folder" Click="OpenInstallFolderClicked"/>
        <MenuItem Header="Edit game…" Click="EditGame"/><MenuItem Header="Sessions &amp; notes" Click="MenuNotesClicked"/><MenuItem Header="Remove from library" Click="ArchiveGame"/>
       </ContextMenu>
       <DataTemplate x:Key="CardTemplate"><Button Click="OpenGameCard" Style="{StaticResource CardButton}" ContextMenu="{StaticResource GameContextMenu}" ContextMenuOpening="GameContextMenuOpening" AutomationProperties.Name="{Binding Name}"><StackPanel Loaded="CoverRowLoaded" Unloaded="CoverRowUnloaded" DataContextChanged="CoverRowChanged">
        <Border Height="276" CornerRadius="12" Background="{DynamicResource AppSurface}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Initial}" FontSize="48" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover}" Stretch="Uniform"/>
         <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="9,3" CornerRadius="11" Background="#CC0E141D"><TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="#edf2f8"/></Border>
         <Border x:Name="HoverBar" VerticalAlignment="Bottom" Margin="8" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Play" Style="{StaticResource PrimaryButton}" Click="CardPlayClicked" Height="36" MinHeight="36" Padding="0" Margin="0,0,6,0" ToolTip="Play" AutomationProperties.Name="Play"/><Button Grid.Column="1" Click="CardMoreClicked" Height="36" MinHeight="36" Padding="0" Width="36" ToolTip="More actions" AutomationProperties.Name="More actions"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 2 7 L 2.01 7 M 7 7 L 7.01 7 M 12 7 L 12.01 7"/></Button></Grid></Border></Grid></Border>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Margin="2,12,0,3" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Played}" Foreground="{DynamicResource AppMuted}" Margin="2,0,0,0"/></StackPanel>
        <Button.Triggers><EventTrigger RoutedEvent="UIElement.MouseEnter"><BeginStoryboard><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/></ObjectAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="UIElement.MouseLeave"><BeginStoryboard><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/></ObjectAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers></Button></DataTemplate>
       <DataTemplate x:Key="RowTemplate"><Button Click="OpenGameCard" Style="{StaticResource CardButton}" Padding="10,6" ContextMenu="{StaticResource GameContextMenu}" ContextMenuOpening="GameContextMenuOpening" AutomationProperties.Name="{Binding Name}"><Grid Loaded="CoverRowLoaded" Unloaded="CoverRowUnloaded" DataContextChanged="CoverRowChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="58" CornerRadius="6" Background="{DynamicResource AppSurface}" ClipToBounds="True" Margin="0,0,16,0"><Grid><TextBlock Text="{Binding Initial}" FontSize="18" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover}" Stretch="Uniform"/></Grid></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Availability}" Foreground="{DynamicResource AppMuted}" FontSize="12.5" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Played}" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}"/><TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}"/>
        <Button Grid.Column="4" Content="Play" Style="{StaticResource PrimaryButton}" Click="CardPlayClicked" Height="34" MinHeight="34" Width="86" Padding="0" Margin="12,0,0,0" AutomationProperties.Name="Play"/></Grid></Button></DataTemplate>
      </ListBox.Resources>
      <ListBox.ItemTemplate><StaticResource ResourceKey="CardTemplate"/></ListBox.ItemTemplate>
     </ListBox><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Visibility="Collapsed"><TextBlock x:Name="EmptyHeading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/></StackPanel><ContentControl x:Name="WelcomeHost" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Focusable="False"/></Grid>
    </Grid>
