<Window x:Class="GameVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameVault — Development build"
        Width="900" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppText}"
        FontFamily="Segoe UI" FontSize="15">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="GameVault" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Local settings and profiles" FontSize="20" Margin="0,8,0,20" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,24"
                       Text="Your settings and game profiles stay in this app’s folder. Game management, playtime tracking, and save backups are coming in the next development steps." />
            <TextBlock Text="Game profiles folder" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox Text="{Binding Profiles, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="Wrap" BorderThickness="0" Padding="0,6"
                     Background="Transparent" Foreground="{DynamicResource AppMuted}"
                     AutomationProperties.Name="Game profiles folder" />
            <TextBlock x:Name="ProfileSummary" Margin="0,8,0,20" Foreground="{DynamicResource AppMuted}" />
            <Label Content="Color theme" Target="{Binding ElementName=ThemeChoice}" Padding="0,0,0,8"
                   Foreground="{DynamicResource AppText}" FontWeight="SemiBold" />
            <ComboBox x:Name="ThemeChoice" Width="220" Height="38" HorizontalAlignment="Left"
                      Foreground="#131b26" Background="#edf2f8" SelectionChanged="ThemeChanged"
                      AutomationProperties.Name="Color theme">
                <ComboBoxItem Tag="Midnight" Content="Midnight (default)" />
                <ComboBoxItem Tag="Crimson" Content="Crimson (red and black)" />
            </ComboBox>
            <TextBlock x:Name="StorageNotice" TextWrapping="Wrap" Margin="0,20,0,0"
                       Foreground="{DynamicResource AppMuted}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</Window>
