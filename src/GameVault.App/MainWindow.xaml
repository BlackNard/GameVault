<Window x:Class="GameVault.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameVault.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="GameVault" Width="1280" Height="850" MinWidth="900" MinHeight="620" WindowState="Maximized" Icon="Assets/GameVault.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Window.Resources>
 <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource AppChrome}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionFrame" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppRaised}"/></Trigger>
   <Trigger Property="local:WindowChromeBehavior.IsNativeMouseOver" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppRaised}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppLine}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource AppDisabledOpacity}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource AppChrome}"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False" Data="M 1 6 L 11 6"/></Button>
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" x:Name="MaximizeCaptionButton" Click="MaximizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 2 2 L 10 2 L 10 10 L 2 10 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 3 1 L 11 1 L 11 9 M 1 3 L 9 3 L 9 11 L 1 11 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Close window" AutomationProperties.Name="Close window" Click="CloseWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False" Data="M 2 2 L 10 10 M 10 2 L 2 10"/></Button>
   </StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="20,0,0,0" VerticalAlignment="Center" LastChildFill="True" ClipToBounds="True"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image Source="Assets/GameVault.ico" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="GameVault" FontWeight="SemiBold" Margin="0,0,14,0"/>
     <Button x:Name="NavBackButton" Style="{StaticResource TitleIconButton}" Click="NavBackClicked" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" IsEnabled="False" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}" IsHitTestVisible="False" Data="M 8 1 L 3 6 L 8 11"/></Button>
     <Button x:Name="NavForwardButton" Style="{StaticResource TitleIconButton}" Click="NavForwardClicked" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" IsEnabled="False" Margin="2,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}" IsHitTestVisible="False" Data="M 4 1 L 9 6 L 4 11"/></Button>
     </StackPanel><TextBlock x:Name="BreadcrumbText" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
    <Button x:Name="PaletteButton" Grid.Column="1" Style="{StaticResource TitlePillButton}" Width="380" Click="OpenPaletteClicked" ToolTip="Search games or run a command (Ctrl+K)" AutomationProperties.Name="Search games or run a command" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Background="{DynamicResource AppRaised}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"><TextBlock Text="Ctrl K" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}"/></Border>
      <Path DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="{x:Null}" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 6 1 A 5 5 0 1 0 6 11 A 5 5 0 1 0 6 1 M 10 10 L 13.5 13.5"/>
      <TextBlock Text="Search games or run a command" TextTrimming="CharacterEllipsis"/></DockPanel></Button>
    <Button x:Name="NowPlayingButton" Grid.Column="2" Style="{StaticResource TitlePillButton}" HorizontalAlignment="Right" Margin="0,0,14,0" Visibility="Collapsed" Click="NowPlayingClicked" ToolTip="Open the running game" AutomationProperties.Name="Running game" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#8fe0b0" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="NowPlayingText" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
   </Grid>
  </DockPanel></Border>
  <Grid x:Name="ContentRoot" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource AppChrome}" BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,1,0"><DockPanel Margin="10,18,10,14">
    <StackPanel DockPanel.Dock="Bottom"><Button x:Name="TrayAlertsButton" Content="Backup alerts" Click="ReviewNextAlert" Visibility="Collapsed" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" Style="{StaticResource RailButton}" Click="ShowSettings" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 8 5.5 A 2.5 2.5 0 1 0 8 10.5 A 2.5 2.5 0 1 0 8 5.5 M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.5 4.5 M 11.5 11.5 L 13 13 M 13 3 L 11.5 4.5 M 4.5 11.5 L 3 13"/><TextBlock Text="Settings"/></StackPanel></Button>
     <Button x:Name="QuitButton" Style="{StaticResource RailButton}" Click="QuitClicked" Margin="0,2,0,0" AutomationProperties.Name="Quit GameVault"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 8 1.5 L 8 8 M 4.2 4.2 A 6 6 0 1 0 11.8 4.2"/><TextBlock Text="Quit GameVault"/></StackPanel></Button></StackPanel>
    <StackPanel><Button x:Name="LibraryNav" Style="{StaticResource RailButton}" Click="ShowLibrary" AutomationProperties.Name="Library"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 2 2.5 L 6.5 2.5 L 6.5 13.5 L 2 13.5 Z M 9 2.5 L 14 2.5 L 14 8.5 L 9 8.5 Z"/><TextBlock Text="Library"/></StackPanel></Button>
     <TextBlock x:Name="RecentHeader" Text="RECENT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" Opacity="0.75" Margin="12,22,0,6" Visibility="Collapsed"/>
     <ItemsControl x:Name="RecentList" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource RailButton}" Height="46" Click="RecentClicked" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}"><StackPanel Orientation="Horizontal"><Border Width="28" Height="38" CornerRadius="5" Background="{DynamicResource AppRaised}" ClipToBounds="True" Margin="-3,0,12,0"><Grid><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}"/><Image Source="{Binding RailIcon}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="120" VerticalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="32,24,32,16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="LibraryPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,24"><Button x:Name="AddButton" Height="40" VerticalAlignment="Center" DockPanel.Dock="Right" Content="+ Add game" Style="{StaticResource PrimaryButton}" Click="AddGame"/><StackPanel><TextBlock Text="Library" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySummary" Text="Loading your games…" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1" Margin="0,0,0,18">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
        <RadioButton x:Name="GridModeButton" GroupName="LibraryMode" IsChecked="True" Style="{StaticResource ChipRadio}" Margin="0,0,6,0" Checked="LibraryModeChanged" ToolTip="Cover grid" AutomationProperties.Name="Cover grid"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="{x:Null}" IsHitTestVisible="False" Data="M 1 1 L 6 1 L 6 6 L 1 6 Z M 8 1 L 13 1 L 13 6 L 8 6 Z M 1 8 L 6 8 L 6 13 L 1 13 Z M 8 8 L 13 8 L 13 13 L 8 13 Z"/></RadioButton>
        <RadioButton x:Name="ListModeButton" GroupName="LibraryMode" Style="{StaticResource ChipRadio}" Margin="0" Checked="LibraryModeChanged" ToolTip="Compact list" AutomationProperties.Name="Compact list"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 1 3 L 13 3 M 1 7 L 13 7 M 1 11 L 13 11"/></RadioButton>
       </StackPanel>
       <Grid DockPanel.Dock="Left" Width="300" VerticalAlignment="Center"><TextBox x:Name="Search" Height="40" Padding="38,0,12,0" VerticalContentAlignment="Center" TextChanged="FilterChanged" AutomationProperties.Name="Search games" ToolTip="Search your library by game name (press / to jump here)"/>
        <Path Width="14" Height="14" Margin="14,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.5" Fill="{x:Null}" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 6 1 A 5 5 0 1 0 6 11 A 5 5 0 1 0 6 1 M 10 10 L 13.5 13.5"/>
        <TextBlock Text="Search games" Margin="38,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
       <WrapPanel Margin="18,0,0,0" VerticalAlignment="Center">
        <RadioButton x:Name="ChipAll" GroupName="StatusChips" IsChecked="True" Tag="All" Content="All" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="Playing" Content="Playing" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="Completed" Content="Completed" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="OnHold" Content="On hold" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="NotStarted" Content="Not started" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <ToggleButton x:Name="ChipRemoved" Content="Removed" Style="{StaticResource ChipToggle}" Checked="RemovedChipChanged" Unchecked="RemovedChipChanged" ToolTip="Show removed games (their data is kept)"/>
       </WrapPanel>
      </DockPanel>
      <StackPanel Visibility="Collapsed"><ComboBox x:Name="StatusFilter" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Game status"><ComboBoxItem Content="All statuses" Tag="All"/><ComboBoxItem Content="Not started" Tag="NotStarted"/><ComboBoxItem Content="Playing" Tag="Playing"/><ComboBoxItem Content="Completed" Tag="Completed"/><ComboBoxItem Content="On hold" Tag="OnHold"/></ComboBox><CheckBox x:Name="RemovedFilter" Content="Removed games" Checked="FilterChanged" Unchecked="FilterChanged"/></StackPanel>
     </Grid>
     <Grid Grid.Row="2"><ListBox x:Name="GameList" SelectionChanged="SelectedGameChanged" PreviewKeyDown="LibraryKeyDown" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Game library">
      <ListBox.ItemsPanel><ItemsPanelTemplate><local:VirtualizingCoverPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.Resources>
       <ContextMenu x:Key="GameContextMenu" Opened="GameContextMenuOpened">
        <MenuItem Header="Play" Click="MenuPlayClicked"/><MenuItem Header="Back up now" Click="MenuBackUpClicked"/><MenuItem Header="Open install folder" Click="OpenInstallFolderClicked"/><Separator/>
        <MenuItem Header="Edit game…" Click="EditGame"/><MenuItem Header="Sessions &amp; notes" Click="MenuNotesClicked"/><Separator/><MenuItem Header="Remove from library" Click="ArchiveGame"/>
       </ContextMenu>
       <DataTemplate x:Key="CardTemplate"><Button Click="OpenGameCard" Style="{StaticResource CardButton}" ContextMenu="{StaticResource GameContextMenu}" ContextMenuOpening="GameContextMenuOpening" AutomationProperties.Name="{Binding Name}"><StackPanel Loaded="CoverRowLoaded" Unloaded="CoverRowUnloaded" DataContextChanged="CoverRowChanged">
        <Border Height="276" CornerRadius="12" Background="{DynamicResource AppSurface}" ClipToBounds="True"><Grid><TextBlock Text="{Binding Initial}" FontSize="48" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover}" Stretch="Uniform"/>
         <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="9,3" CornerRadius="11" Background="#CC0E141D"><TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="#edf2f8"/></Border>
         <Border x:Name="HoverBar" VerticalAlignment="Bottom" Margin="8" Visibility="Collapsed"><StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch"><Button Content="Play" Style="{StaticResource PrimaryButton}" Click="CardPlayClicked" Height="36" MinHeight="36" Padding="0" Width="118" Margin="0,0,6,0" ToolTip="Play" AutomationProperties.Name="Play"/><Button Click="CardMoreClicked" Height="36" MinHeight="36" Padding="0" Width="48" ToolTip="More actions" AutomationProperties.Name="More actions"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 2 7 L 2.01 7 M 7 7 L 7.01 7 M 12 7 L 12.01 7"/></Button></StackPanel></Border></Grid></Border>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" Margin="2,12,0,3" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Played}" Foreground="{DynamicResource AppMuted}" Margin="2,0,0,0"/></StackPanel>
        <Button.Triggers><EventTrigger RoutedEvent="UIElement.MouseEnter"><BeginStoryboard><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/></ObjectAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="UIElement.MouseLeave"><BeginStoryboard><Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/></ObjectAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger></Button.Triggers></Button></DataTemplate>
       <DataTemplate x:Key="RowTemplate"><Button Click="OpenGameCard" Style="{StaticResource CardButton}" Padding="10,6" ContextMenu="{StaticResource GameContextMenu}" ContextMenuOpening="GameContextMenuOpening" AutomationProperties.Name="{Binding Name}"><Grid Loaded="CoverRowLoaded" Unloaded="CoverRowUnloaded" DataContextChanged="CoverRowChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="58" CornerRadius="6" Background="{DynamicResource AppSurface}" ClipToBounds="True" Margin="0,0,16,0"><Grid><TextBlock Text="{Binding Initial}" FontSize="18" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover}" Stretch="Uniform"/></Grid></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Availability}" Foreground="{DynamicResource AppMuted}" FontSize="12.5" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Played}" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}"/><TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}"/>
        <Button Grid.Column="4" Content="Play" Style="{StaticResource PrimaryButton}" Click="CardPlayClicked" Height="34" MinHeight="34" Width="86" Padding="0" Margin="12,0,0,0" AutomationProperties.Name="Play"/></Grid></Button></DataTemplate>
      </ListBox.Resources>
      <ListBox.ItemTemplate><StaticResource ResourceKey="CardTemplate"/></ListBox.ItemTemplate>
     </ListBox><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Visibility="Collapsed"><TextBlock x:Name="EmptyHeading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/></StackPanel></Grid>
    </Grid>
    <Grid x:Name="GamePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <Border CornerRadius="16" ClipToBounds="True" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" Background="{DynamicResource AppSurface}">
       <Grid Height="250">
        <Image x:Name="GameHeroBackdrop" Source="{Binding Source, ElementName=GameHeroCover}" Stretch="UniformToFill" Opacity="0.32" VerticalAlignment="Center"/>
        <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#330E141D" Offset="0"/><GradientStop Color="#F20E141D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <Grid Margin="26,24,26,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="96" Height="144" Background="{DynamicResource AppSurface}" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Bottom" BorderBrush="{DynamicResource AppLine}" BorderThickness="1"><Image x:Name="GameHeroCover" Stretch="Uniform"/></Border>
         <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom"><TextBlock x:Name="DetailTitle" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailState" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
          <WrapPanel><Button x:Name="PlayButton" Content="Play" Width="150" Height="44" Style="{StaticResource PrimaryButton}" Click="PlayGame" Margin="0,0,10,0" ToolTip="Play"/>
           <Button x:Name="EditButton" Style="{StaticResource HeroIconButton}" Click="EditGame" Margin="0,0,8,0" ToolTip="Edit game" AutomationProperties.Name="Edit game"><Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 2 14 L 2 11 L 11 2 L 14 5 L 5 14 Z M 9.5 3.5 L 12.5 6.5"/></Button>
           <Button x:Name="OpenFolderButton" Style="{StaticResource HeroIconButton}" Click="OpenInstallFolderClicked" Margin="0,0,8,0" ToolTip="Open install folder" AutomationProperties.Name="Open install folder"><Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 1 4 L 6 4 L 8 6 L 15 6 L 15 14 L 1 14 Z"/></Button>
           <Button x:Name="HeroBackupButton" Style="{StaticResource HeroIconButton}" Click="BackUpNow" IsEnabled="{Binding IsEnabled, ElementName=BackupButton}" Margin="0,0,8,0" ToolTip="Back up saves now" AutomationProperties.Name="Back up saves now"><Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 8 1 L 14 3.5 L 14 8 C 14 11.5 11.5 13.5 8 15 C 4.5 13.5 2 11.5 2 8 L 2 3.5 Z M 5.5 8 L 7.3 9.8 L 10.6 6.4"/></Button>
           <Button x:Name="GameOptionsButton" Style="{StaticResource HeroIconButton}" Click="ToggleGameOptions" ToolTip="More options" AutomationProperties.Name="More options"><Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 2.5 8 L 2.51 8 M 8 8 L 8.01 8 M 13.5 8 L 13.51 8"/></Button>
           <Popup x:Name="GameOptionsPopup" PlacementTarget="{Binding ElementName=GameOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="False"><Border Background="{DynamicResource AppChrome}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" Padding="8" CornerRadius="10"><StackPanel MinWidth="210"><Button x:Name="LaunchSettingsButton" Content="Launch settings" Click="ConfigureLaunch" Margin="0,0,0,6"/><Button x:Name="ArchiveButton" Content="Remove from library" Click="ArchiveGame"/></StackPanel></Border></Popup></WrapPanel></StackPanel></Grid>
       </Grid>
      </Border>
      <TextBlock x:Name="LaunchNotice" Foreground="{DynamicResource AppAccent}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel Margin="0,14,0,0">
       <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="12" Padding="16,10" MinWidth="170" Margin="0,0,12,0"><StackPanel><TextBlock Text="Total playtime" Foreground="{DynamicResource AppMuted}" FontSize="12"/><TextBlock Text="{Binding Text, ElementName=DetailTime}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
       <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="12" Padding="16,10" MinWidth="170"><StackPanel><TextBlock Text="Latest session" Foreground="{DynamicResource AppMuted}" FontSize="12"/><TextBlock Text="{Binding Text, ElementName=SessionElapsed}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
      </WrapPanel></StackPanel>
     <Border Grid.Row="1" BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,0,1" Margin="0,22,0,20"><WrapPanel><Button x:Name="OverviewTab" Content="Overview" Tag="Overview" Click="GameTabClicked" Style="{StaticResource TabLink}"/><Button x:Name="NotesButton" Content="Sessions &amp; notes" Tag="Sessions" Click="GameTabClicked" Style="{StaticResource TabLink}"/><Button x:Name="SavesTab" Content="Saves" Tag="Saves" Click="GameTabClicked" Style="{StaticResource TabLink}"/><Button x:Name="MediaTab" Content="Media" Tag="Media" Click="GameTabClicked" Style="{StaticResource TabLink}"/></WrapPanel></Border>
     <Grid Grid.Row="2"><ScrollViewer x:Name="DetailFields" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <StackPanel x:Name="OverviewSection"><WrapPanel Margin="0,0,0,32" Visibility="Collapsed"><StackPanel Margin="0,0,56,0"><TextBlock Text="Total playtime" Foreground="{DynamicResource AppMuted}"/><TextBlock x:Name="DetailTime" FontSize="24" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="Latest session" Foreground="{DynamicResource AppMuted}"/><TextBlock x:Name="SessionElapsed" FontSize="20" Margin="0,6,0,0"/></StackPanel></WrapPanel><TextBlock x:Name="SessionWarning" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap"/><TextBlock Text="Save backup status" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="{Binding Text, ElementName=BackupNotice}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><Button Content="View backups and resolve issues" Tag="Saves" Click="GameTabClicked" HorizontalAlignment="Left" Margin="0,12,0,24"/><TextBlock Text="Your game, at a glance" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,16"/><TextBlock Text="Open Sessions &amp; notes to see individual play sessions, write notes or export your journal. Saves contains your backup history and restore options." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel x:Name="SavesSection" Visibility="Collapsed" MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="Save backups" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BackupNotice" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,8"/><TextBlock x:Name="LastBackup" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,0,0,16"/><WrapPanel><Button x:Name="BackupButton" Content="Back up now" Click="BackUpNow" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button x:Name="BackupHistoryButton" Content="Backup history" Click="OpenBackupHistory" Margin="0,0,12,8"/><Button Content="Open backup folder" Click="OpenBackupDirectory" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Backup destination" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="GameBackupLocation" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"/><WrapPanel Margin="0,12,0,24"><Button Content="Choose game backup folder" Click="ChooseGameBackupDirectory" Margin="0,0,12,0"/><Button Content="Use default location" Click="ResetGameBackupDirectory"/></WrapPanel><TextBlock Text="Live save locations" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DetailSaves" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,16"/><Button x:Name="SaveSourcesButton" Content="Manage save sources" Click="OpenSaveSources" HorizontalAlignment="Left"/><Expander Header="Game file locations" Margin="0,24,0,0"><StackPanel><Label Content="Executable"/><TextBox x:Name="DetailExecutable" IsReadOnly="True" TextWrapping="Wrap"/><Label Content="Working directory"/><TextBox x:Name="DetailWorking" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel>
      <StackPanel x:Name="MediaSection" Visibility="Collapsed"><local:CaptureControls x:Name="GameCaptureControls" Margin="0,0,0,20"/><Expander x:Name="CaptureMediaExpander" Header="Screenshots and recordings" Expanded="CaptureMediaExpanded" IsExpanded="True"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="CaptureMediaNotice" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><ListBox x:Name="CaptureMediaList" MaxHeight="350" SelectionChanged="CaptureMediaSelected" Margin="0,16,0,12" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/><Button x:Name="OpenCaptureMediaButton" Content="Open selected capture" IsEnabled="False" Click="OpenCaptureMedia" HorizontalAlignment="Left"/></StackPanel></Expander></StackPanel>
     </StackPanel></ScrollViewer><ContentControl x:Name="NotesHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Grid>
    </Grid>
    <Grid x:Name="SettingsPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,4,18,0"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,18"/><Button Content="Appearance" Tag="SetAppearance" Click="SettingsSectionClicked" Style="{StaticResource RailButton}" Height="36"/><Button Content="Backups" Tag="SetBackups" Click="SettingsSectionClicked" Style="{StaticResource RailButton}" Height="36"/><Button Content="Background" Tag="SetBackground" Click="SettingsSectionClicked" Style="{StaticResource RailButton}" Height="36"/><Button Content="Capture" Tag="CaptureSettings" Click="SettingsSectionClicked" Style="{StaticResource RailButton}" Height="36"/><Button Content="Storage" Tag="SetStorage" Click="SettingsSectionClicked" Style="{StaticResource RailButton}" Height="36"/></StackPanel><ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock x:Name="SetAppearance" Text="Appearance" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12"/><Label Content="Color theme" Target="{Binding ElementName=ThemeChoice}"/><ComboBox x:Name="ThemeChoice" Width="260" HorizontalAlignment="Left" SelectionChanged="ThemeChanged"><ComboBoxItem Tag="Midnight" Content="Midnight (default)"/><ComboBoxItem Tag="Crimson" Content="Crimson (red and black)"/></ComboBox><TextBlock x:Name="SetBackups" Text="Backup storage" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12"/><TextBlock Text="Choose the default destination for future backups. Existing snapshots stay available in their original folders." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><TextBlock x:Name="DefaultBackupLocation" TextWrapping="Wrap" Margin="0,12,0,12"/><WrapPanel><Button Content="Choose default backup folder" Click="ChooseDefaultBackupDirectory" Margin="0,0,12,0"/><Button Content="Use portable profile folders" Click="ResetDefaultBackupDirectory"/></WrapPanel><TextBlock x:Name="SetBackground" Text="Background behavior" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12"/><CheckBox x:Name="CloseToTrayChoice" Content="Keep tracking in the tray when the window closes" Checked="TrayPreferencesChanged" Unchecked="TrayPreferencesChanged" Margin="0,0,0,12"/><CheckBox x:Name="BackupNotificationsChoice" Content="Notify me when a backup needs attention" Checked="TrayPreferencesChanged" Unchecked="TrayPreferencesChanged"/><local:CaptureSettingsView x:Name="CaptureSettings" Margin="0,32,0,16"/><Expander x:Name="SetStorage" Header="Local profile storage" Margin="0,12,0,16"><TextBlock x:Name="ProfilesPath" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/></Expander></StackPanel></ScrollViewer></Grid>
    <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock x:Name="OperationNotice" Visibility="Collapsed" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><TextBlock x:Name="StorageNotice" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   </Grid>
  </Grid>
  <!-- Command palette (Ctrl+K) -->
  <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
   <Border Background="#B0060A10" MouseDown="PaletteScrimClicked"/>
   <Border VerticalAlignment="Top" HorizontalAlignment="Center" Width="640" Margin="0,84,0,0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="14">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Margin="12"><TextBox x:Name="PaletteInput" FontSize="16" Height="44" Padding="12,0" VerticalContentAlignment="Center" TextChanged="PaletteInputChanged" PreviewKeyDown="PaletteInputKeyDown" AutomationProperties.Name="Search games or run a command"/>
      <TextBlock Text="Type a game name or a command…" FontSize="16" Foreground="{DynamicResource AppMuted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PaletteInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <TextBlock x:Name="PaletteEmpty" DockPanel.Dock="Bottom" Text="No match. Try a game name or a command such as Settings." Foreground="{DynamicResource AppMuted}" Margin="20,4,20,16" Visibility="Collapsed"/>
     <TextBlock DockPanel.Dock="Bottom" Text="Up and Down to move · Enter to run · Esc to close" FontSize="12" Foreground="{DynamicResource AppMuted}" Margin="20,0,20,12"/>
     <ListBox x:Name="PaletteList" MaxHeight="360" Margin="8,0,8,4" BorderThickness="0" Background="Transparent" PreviewMouseLeftButtonUp="PaletteListClicked" AutomationProperties.Name="Results">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Group}" Foreground="{DynamicResource AppMuted}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>
  <!-- Side drawer for Edit game, Launch settings and Add game -->
  <Grid x:Name="DrawerLayer" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="30">
   <Border Background="#A0060A10"/>
   <Border x:Name="DrawerPanel" HorizontalAlignment="Right" Width="700" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1,0,0,0" Padding="28,24,28,20"><ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Border>
  </Grid>
  <!-- Toasts -->
  <ItemsControl x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="380" Margin="0,0,24,24" Panel.ZIndex="40" Focusable="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Notifications">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="12" Background="{DynamicResource AppRaised}" BorderThickness="1">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AppWarning}"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Width="26" Height="26" MinHeight="26" VerticalAlignment="Top" Tag="{Binding Id}" Click="DismissToast" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification"><Path Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" IsHitTestVisible="False" Data="M 1 1 L 8 8 M 8 1 L 1 8"/></Button>
      <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Visibility="{Binding ActionVisibility}" Tag="{Binding Id}" Click="ToastActionClicked" Margin="8,0,4,0" VerticalAlignment="Top" Height="28" MinHeight="28" Padding="10,0"/>
      <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
     </DockPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </Grid>
</Window>
