       <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="12" Padding="16,10" MinWidth="170"><StackPanel><TextBlock Text="Latest session" Foreground="{DynamicResource AppMuted}" FontSize="12"/><TextBlock Text="{Binding Text, ElementName=SessionElapsed}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
      </WrapPanel></StackPanel>
     <Border Grid.Row="1" BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,0,1" Margin="0,22,0,20"><WrapPanel><Button x:Name="OverviewTab" Content="Overview" Tag="Overview" Click="GameTabClicked" Style="{StaticResource TabLink}"/><Button x:Name="NotesButton" Content="Sessions &amp; notes" Tag="Sessions" Click="GameTabClicked" Style="{StaticResource TabLink}"/><Button x:Name="SavesTab" Content="Saves" Tag="Saves" Click="GameTabClicked" Style="{StaticResource TabLink}"/><Button x:Name="MediaTab" Content="Media" Tag="Media" Click="GameTabClicked" Style="{StaticResource TabLink}"/></WrapPanel></Border>
     <Grid Grid.Row="2"><ScrollViewer x:Name="DetailFields" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <StackPanel x:Name="OverviewSection"><StackPanel x:Name="TagsBlock" Margin="0,0,0,24" Visibility="Collapsed"><TextBlock Text="My tags" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="Your own tags and categories for organizing your library. Only you see them, and you can filter the library by them. They are separate from the store tags shown further down." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,0,0,10" MaxWidth="700" HorizontalAlignment="Left"/><TextBlock x:Name="TagsText" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"/><Button x:Name="EditTagsButton" Content="Edit my tags…" Click="EditTagsClicked" HorizontalAlignment="Left" Margin="0,10,0,0"/><StackPanel x:Name="TagsEditor" Visibility="Collapsed" Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left"><TextBox x:Name="TagsInput" MaxLength="400" KeyDown="TagsInputKeyDown" AutomationProperties.Name="Tags separated by commas"/><TextBlock Text="Separate tags with commas. Up to 12 tags of 30 characters per game." Foreground="{DynamicResource AppMuted}" Margin="0,6,0,8"/><WrapPanel><Button Content="Save tags" Style="{StaticResource PrimaryButton}" Click="SaveTagsClicked" Margin="0,0,8,0"/><Button Content="Cancel" Click="CancelTagsClicked"/></WrapPanel></StackPanel></StackPanel><StackPanel x:Name="AboutBlock" Margin="0,0,0,24" Visibility="Collapsed" MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="About this game" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="AboutText" TextWrapping="Wrap"/><ProgressBar x:Name="AboutLookupBar" IsIndeterminate="True" Height="3" MaxWidth="360" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/><WrapPanel x:Name="AboutFacts" Margin="0,14,0,0"/><StackPanel x:Name="AboutDetails"/><TextBlock x:Name="AboutSource" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button x:Name="RefreshInfoButton" Content="Refresh info" Click="RefreshInfoClicked" Margin="0,0,10,0" ToolTip="Look up the description, release date, developers, genres and install size"/><Button x:Name="EditDescriptionButton" Content="Edit description…" Click="EditDescriptionClicked" Margin="0,0,10,0"/><Button x:Name="WrongGameButton" Content="Not the right game?" Click="WrongGameClicked" ToolTip="Choose the correct game from Steam, GOG or Wikidata"/></WrapPanel><StackPanel x:Name="DescriptionEditor" Visibility="Collapsed" Margin="0,10,0,0"><TextBox x:Name="DescriptionInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="4000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Game description"/><WrapPanel Margin="0,8,0,0"><Button Content="Save description" Style="{StaticResource PrimaryButton}" Click="SaveDescriptionClicked" Margin="0,0,8,0"/><Button Content="Cancel" Click="CancelDescriptionClicked"/></WrapPanel></StackPanel><TextBlock x:Name="AboutNotice" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><WrapPanel Margin="0,0,0,32" Visibility="Collapsed"><StackPanel Margin="0,0,56,0"><TextBlock Text="Total playtime" Foreground="{DynamicResource AppMuted}"/><TextBlock x:Name="DetailTime" FontSize="24" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="Latest session" Foreground="{DynamicResource AppMuted}"/><TextBlock x:Name="SessionElapsed" FontSize="20" Margin="0,6,0,0"/></StackPanel></WrapPanel><TextBlock x:Name="SessionWarning" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap"/><TextBlock Text="Save backup status" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="{Binding Text, ElementName=BackupNotice}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><Button Content="View backups and resolve issues" Tag="Saves" Click="GameTabClicked" HorizontalAlignment="Left" Margin="0,12,0,24"/><TextBlock Text="Your game, at a glance" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,16"/><TextBlock Text="Open Sessions &amp; notes to see individual play sessions, write notes or export your journal. Saves contains your backup history and restore options." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel x:Name="SavesSection" Visibility="Collapsed" MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="Save backups" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="BackupNotice" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,8"/><TextBlock x:Name="LastBackup" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,0,0,16"/><WrapPanel><Button x:Name="BackupButton" Content="Back up now" Click="BackUpNow" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"/><Button x:Name="BackupHistoryButton" Content="Backup history" Click="OpenBackupHistory" Margin="0,0,12,8"/><Button Content="Open backup folder" Click="OpenBackupDirectory" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Backup destination" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="GameBackupLocation" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"/><WrapPanel Margin="0,12,0,24"><Button Content="Choose game backup folder" Click="ChooseGameBackupDirectory" Margin="0,0,12,0"/><Button Content="Use default location" Click="ResetGameBackupDirectory"/></WrapPanel><TextBlock Text="Live save locations" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DetailSaves" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,16"/><Button x:Name="SaveSourcesButton" Content="Manage save sources" Click="OpenSaveSources" HorizontalAlignment="Left"/><Expander Header="Game file locations" Margin="0,24,0,0"><StackPanel><Label Content="Executable"/><TextBox x:Name="DetailExecutable" IsReadOnly="True" TextWrapping="Wrap"/><Label Content="Working directory"/><TextBox x:Name="DetailWorking" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel>
      <StackPanel x:Name="MediaSection" Visibility="Collapsed"><local:CaptureControls x:Name="GameCaptureControls" Margin="0,0,0,20"/><Expander x:Name="CaptureMediaExpander" Header="Screenshots and recordings" Expanded="CaptureMediaExpanded" IsExpanded="True"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="CaptureMediaNotice" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><ListBox x:Name="CaptureMediaList" MaxHeight="350" SelectionChanged="CaptureMediaSelected" Margin="0,16,0,12" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/><Button x:Name="OpenCaptureMediaButton" Content="Open selected capture" IsEnabled="False" Click="OpenCaptureMedia" HorizontalAlignment="Left"/></StackPanel></Expander></StackPanel>
     </StackPanel></ScrollViewer><ContentControl x:Name="NotesHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Grid>
    </Grid>
    <Grid x:Name="SettingsPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,4,18,0"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,14"/></StackPanel><ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock x:Name="SetAppearance" Text="Appearance" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12"/><Label Content="Color theme" Target="{Binding ElementName=ThemeChoice}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="ThemeName" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/><Button x:Name="BrowseThemesButton" Content="Browse themes…" Click="BrowseThemesClicked" MinWidth="150" AutomationProperties.Name="Browse themes"/></StackPanel><TextBlock x:Name="SetBackups" Text="Backup storage" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12"/><TextBlock Text="Choose the default destination for future backups. Existing snapshots stay available in their original folders." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><TextBlock x:Name="DefaultBackupLocation" TextWrapping="Wrap" Margin="0,12,0,12"/><WrapPanel><Button Content="Choose default backup folder" Click="ChooseDefaultBackupDirectory" Margin="0,0,12,0"/><Button Content="Use portable profile folders" Click="ResetDefaultBackupDirectory"/></WrapPanel><TextBlock x:Name="SetBackground" Text="Background behavior" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12"/><CheckBox x:Name="CloseToTrayChoice" Content="Keep tracking in the tray when the window closes" Checked="TrayPreferencesChanged" Unchecked="TrayPreferencesChanged" Margin="0,0,0,12"/><CheckBox x:Name="BackupNotificationsChoice" Content="Notify me when a backup needs attention" Checked="TrayPreferencesChanged" Unchecked="TrayPreferencesChanged"/><CheckBox x:Name="StartupSplashChoice" Content="Show a small startup window while GameVault loads" Checked="SplashPreferenceChanged" Unchecked="SplashPreferenceChanged" Margin="0,12,0,0"/><local:CaptureSettingsView x:Name="CaptureSettings" Margin="0,32,0,16"/><TextBlock x:Name="SetData" Text="GameVault data" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="Back up GameVault itself (game profiles, sessions, notes and settings) into one zip, for example before an upgrade or when moving to another PC. Restoring replaces the whole library and keeps a copy of what it replaced." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><CheckBox x:Name="DataBackupBulky" Content="Include game backups and recorded media (can be large)" Margin="0,12,0,12"/><WrapPanel><Button Content="Back up GameVault data…" Click="BackUpDataClicked" Margin="0,0,12,0"/><Button Content="Restore from a backup…" Click="RestoreDataClicked"/></WrapPanel><TextBlock x:Name="SetSaveDatabase" Text="Save-location database" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/><TextBlock Text="An optional community list of where games keep their saves (the Ludusavi manifest, compiled from PCGamingWiki, licensed Creative Commons Attribution-NonCommercial-ShareAlike 3.0). It is downloaded only when you press the button, from GitHub, and nothing about you or your games is sent. Its suggestions only appear for confirmation and are never selected automatically." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><TextBlock x:Name="SaveDatabaseStatusText" TextWrapping="Wrap" Margin="0,10,0,10"/><Button x:Name="DownloadSaveDatabaseButton" Content="Download the save-location database" Click="DownloadSaveDatabaseClicked" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock x:Name="SetInfo" Text="Game information" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/><TextBlock Text="Descriptions, release dates, developers, genres and install sizes are looked up automatically for new games and for games that have none yet (you can also use Refresh info on a game, or fetch for all games). Games installed through Steam, Epic or GOG are looked up in that store by their id; other games are searched by exact title (the title is sent) in the Steam store, GOG and Wikidata, and used only when exactly one game has that title. If several games share a title, choose Not the right game? on the game page. Your own text is never replaced. Nothing you typed is ever replaced." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel x:Name="MetadataFields"/><WrapPanel Margin="0,8,0,0"><Button x:Name="FetchAllInfoButton" Content="Fetch missing info for all games" Click="FetchAllInfoClicked" Margin="0,0,10,0"/><Button x:Name="CancelFetchAllButton" Content="Cancel" Click="CancelFetchAllClicked" Visibility="Collapsed"/></WrapPanel><TextBlock x:Name="FetchAllProgress" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="SetViews" Text="Saved views" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/><TextBlock Text="Saved views appear as quick buttons above the library. Rename them, change their order or delete them here." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel x:Name="SavedViewsManager"/><TextBlock x:Name="SetDiagnostics" Text="Diagnostics" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/><TextBlock Text="Create a zip with GameVault and PC details, redacted settings, counts and recent log lines to attach to a bug report. You see what is inside before it is saved." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><CheckBox x:Name="DiagnosticsGameNames" Content="Include game names" Margin="0,12,0,12"/><Button Content="Create diagnostics package…" Click="CreateDiagnosticsClicked" HorizontalAlignment="Left" Margin="0,0,0,16"/><Expander x:Name="SetStorage" Header="Local profile storage" Margin="0,12,0,16"><TextBlock x:Name="ProfilesPath" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/></Expander></StackPanel></ScrollViewer></Grid>
    <Grid x:Name="OverviewPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock x:Name="OverviewTitle" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="OverviewSubtitle" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <ItemsControl x:Name="OverviewList" Focusable="False">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10" MaxWidth="900" HorizontalAlignment="Left">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Border Width="42" Height="58" CornerRadius="6" Background="{DynamicResource AppRaised}" ClipToBounds="True" Margin="0,0,14,0"><Grid><TextBlock Text="{Binding Item.Initial}" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Item.RailIcon}" Stretch="Uniform"/></Grid></Border>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="320"><TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource AppMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Button Content="{Binding PrimaryLabel}" IsEnabled="{Binding PrimaryEnabled}" Click="OverviewPrimaryClicked" Height="34" MinHeight="34" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Open game" Click="OverviewOpenGameClicked" Height="34" MinHeight="34" Padding="14,0"/>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <ItemsControl x:Name="CaptureGroups" Focusable="False" Visibility="Collapsed">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" MaxWidth="900" HorizontalAlignment="Left" MinWidth="620">
          <StackPanel>
           <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Open game" Click="CaptureGroupOpenGameClicked" Height="32" MinHeight="32" Padding="14,0" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Left" Width="36" Height="50" CornerRadius="6" Background="{DynamicResource AppRaised}" ClipToBounds="True" Margin="0,0,12,0"><Grid><TextBlock Text="{Binding Item.Initial}" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Item.RailIcon}" Stretch="Uniform"/></Grid></Border>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AppMuted}" Margin="0,2,0,0"/></StackPanel>
           </DockPanel>
           <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
            <ItemsControl.ItemTemplate><DataTemplate>
             <Grid Margin="0,0,0,2" Height="36">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="{Binding When}" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}"/>
              <Button Grid.Column="2" Content="Open" Click="CaptureLineOpenClicked" IsEnabled="{Binding CanOpen}" Height="30" MinHeight="30" Padding="14,0"/>
             </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
           <TextBlock Text="{Binding More}" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,0" Visibility="{Binding MoreVisibility}"/>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <StackPanel x:Name="OverviewEmpty" Visibility="Collapsed" Margin="0,40,0,0" HorizontalAlignment="Left"><TextBlock x:Name="OverviewEmptyText" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" MaxWidth="480"/></StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock x:Name="OperationNotice" Visibility="Collapsed" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/><TextBlock x:Name="StorageNotice" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   </Grid>
  </Grid>
  <!-- Command palette (Ctrl+K) -->
  <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
   <Border Background="#B0060A10" MouseDown="PaletteScrimClicked"/>
   <Border VerticalAlignment="Top" HorizontalAlignment="Center" Width="640" Margin="0,84,0,0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="14">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Margin="12"><TextBox x:Name="PaletteInput" FontSize="16" Height="44" Padding="12,0" VerticalContentAlignment="Center" TextChanged="PaletteInputChanged" PreviewKeyDown="PaletteInputKeyDown" AutomationProperties.Name="Search games or run a command"/>
      <TextBlock Text="Type a game name or a command…" FontSize="16" Foreground="{DynamicResource AppMuted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PaletteInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <TextBlock x:Name="PaletteEmpty" DockPanel.Dock="Bottom" Text="No match. Try a game name or a command such as Settings." Foreground="{DynamicResource AppMuted}" Margin="20,4,20,16" Visibility="Collapsed"/>
     <TextBlock DockPanel.Dock="Bottom" Text="Up and Down to move · Enter to run · Esc to close" FontSize="12" Foreground="{DynamicResource AppMuted}" Margin="20,0,20,12"/>
