<Window x:Class="GameVault.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameVault.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="GameVault" Width="1280" Height="850" MinWidth="900" MinHeight="620" WindowState="Maximized" Icon="Assets/GameVault.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Window.Resources>
 <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource AppChrome}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionFrame" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppRaised}"/></Trigger>
   <Trigger Property="local:WindowChromeBehavior.IsNativeMouseOver" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppRaised}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionFrame" Property="Background" Value="{DynamicResource AppLine}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource AppDisabledOpacity}"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource AppChrome}"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="MinimizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False" Data="M 1 6 L 11 6"/></Button>
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" x:Name="MaximizeCaptionButton" Click="MaximizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 2 2 L 10 2 L 10 10 L 2 10 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 3 1 L 11 1 L 11 9 M 1 3 L 9 3 L 9 11 L 1 11 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
    <Button Style="{StaticResource CaptionButton}" Width="46" ToolTip="Close window" AutomationProperties.Name="Close window" Click="CloseWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="{x:Null}" IsHitTestVisible="False" Data="M 2 2 L 10 10 M 10 2 L 2 10"/></Button>
   </StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="20,0,0,0" VerticalAlignment="Center" LastChildFill="True" ClipToBounds="True"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image Source="Assets/GameVault.ico" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="GameVault" FontWeight="SemiBold" Margin="0,0,14,0"/>
     <Button x:Name="NavBackButton" Style="{StaticResource TitleIconButton}" Click="NavBackClicked" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" IsEnabled="False" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}" IsHitTestVisible="False" Data="M 8 1 L 3 6 L 8 11"/></Button>
     <Button x:Name="NavForwardButton" Style="{StaticResource TitleIconButton}" Click="NavForwardClicked" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" IsEnabled="False" Margin="2,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}" IsHitTestVisible="False" Data="M 4 1 L 9 6 L 4 11"/></Button>
     </StackPanel><TextBlock x:Name="BreadcrumbText" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
    <Button x:Name="PaletteButton" Grid.Column="1" Style="{StaticResource TitlePillButton}" Width="380" Click="OpenPaletteClicked" ToolTip="Search games or run a command (Ctrl+K)" AutomationProperties.Name="Search games or run a command" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Background="{DynamicResource AppRaised}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"><TextBlock Text="Ctrl K" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}"/></Border>
      <Path DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="{x:Null}" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 6 1 A 5 5 0 1 0 6 11 A 5 5 0 1 0 6 1 M 10 10 L 13.5 13.5"/>
      <TextBlock Text="Search games or run a command" TextTrimming="CharacterEllipsis"/></DockPanel></Button>
    <Button x:Name="NowPlayingButton" Grid.Column="2" Style="{StaticResource TitlePillButton}" HorizontalAlignment="Right" Margin="0,0,14,0" Visibility="Collapsed" Click="NowPlayingClicked" ToolTip="Open the running game" AutomationProperties.Name="Running game" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#8fe0b0" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="NowPlayingText" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
   </Grid>
  </DockPanel></Border>
  <Grid x:Name="ContentRoot" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource AppChrome}" BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,1,0"><DockPanel Margin="10,18,10,14">
    <StackPanel DockPanel.Dock="Bottom"><Button x:Name="TrayAlertsButton" Content="Backup alerts" Click="ReviewNextAlert" Visibility="Collapsed" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" Style="{StaticResource RailButton}" Click="ShowSettings" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 8 5.5 A 2.5 2.5 0 1 0 8 10.5 A 2.5 2.5 0 1 0 8 5.5 M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.5 4.5 M 11.5 11.5 L 13 13 M 13 3 L 11.5 4.5 M 4.5 11.5 L 3 13"/><TextBlock Text="Settings"/></StackPanel></Button>
     <Button x:Name="QuitButton" Style="{StaticResource RailButton}" Click="QuitClicked" Margin="0,2,0,0" AutomationProperties.Name="Quit GameVault"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 8 1.5 L 8 8 M 4.2 4.2 A 6 6 0 1 0 11.8 4.2"/><TextBlock Text="Quit GameVault"/></StackPanel></Button></StackPanel>
    <StackPanel><Button x:Name="LibraryNav" Style="{StaticResource RailButton}" Click="ShowLibrary" AutomationProperties.Name="Library"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 2 2.5 L 6.5 2.5 L 6.5 13.5 L 2 13.5 Z M 9 2.5 L 14 2.5 L 14 8.5 L 9 8.5 Z"/><TextBlock Text="Library"/></StackPanel></Button>
     <Button x:Name="BackupsNav" Style="{StaticResource RailButton}" Click="ShowBackupsOverview" AutomationProperties.Name="Backups"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 2 4 A 6 2 0 1 0 14 4 A 6 2 0 1 0 2 4 M 2 4 L 2 12 A 6 2 0 0 0 14 12 L 14 4 M 2 8 A 6 2 0 0 0 14 8"/><TextBlock Text="Backups"/></StackPanel></Button>
     <Button x:Name="CapturesNav" Style="{StaticResource RailButton}" Click="ShowCapturesOverview" AutomationProperties.Name="Captures"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeLineJoin="Round" IsHitTestVisible="False" Data="M 1.5 4.5 L 14.5 4.5 L 14.5 13 L 1.5 13 Z M 5.5 4.5 L 6.5 2.5 L 9.5 2.5 L 10.5 4.5 M 8 6.5 A 2.3 2.3 0 1 0 8 11.1 A 2.3 2.3 0 1 0 8 6.5"/><TextBlock Text="Captures"/></StackPanel></Button>
          <TextBlock x:Name="RecentHeader" Text="RECENT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" Opacity="0.75" Margin="12,22,0,6" Visibility="Collapsed"/>
     <ItemsControl x:Name="RecentList" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource RailButton}" Height="46" Click="RecentClicked" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}"><StackPanel Orientation="Horizontal"><Border Width="28" Height="38" CornerRadius="5" Background="{DynamicResource AppRaised}" ClipToBounds="True" Margin="-3,0,12,0"><Grid><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}"/><Image Source="{Binding RailIcon}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="120" VerticalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="32,24,32,16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="LibraryPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,24"><Button x:Name="StoreImportButton" Height="40" VerticalAlignment="Center" DockPanel.Dock="Right" Content="Add from Steam / Epic" Margin="10,0,0,0" Click="AddFromStoresClicked" ToolTip="Add games that are already installed through Steam or Epic" AutomationProperties.Name="Add games from Steam or Epic"/><Button x:Name="AddButton" Height="40" VerticalAlignment="Center" DockPanel.Dock="Right" Content="+ Add game" Style="{StaticResource PrimaryButton}" Click="AddGame"/><StackPanel><TextBlock Text="Library" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySummary" Text="Loading your games…" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
     <StackPanel x:Name="ContinueRow" Grid.Row="1" Margin="0,0,0,20" Visibility="Collapsed">
      <TextBlock Text="CONTINUE PLAYING" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" Margin="2,0,0,8"/>
      <ItemsControl x:Name="ContinueList" Focusable="False">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" Padding="8" Width="290">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Grid.ColumnSpan="2" Style="{StaticResource CardButton}" Click="ContinueOpenClicked" AutomationProperties.Name="{Binding Name}" ToolTip="Open game page" Padding="0">
           <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="58" CornerRadius="6" Background="{DynamicResource AppRaised}" ClipToBounds="True" Margin="0,0,12,0"><Grid><TextBlock Text="{Binding Initial}" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding RailIcon}" Stretch="Uniform"/></Grid></Border>
            <StackPanel VerticalAlignment="Center" Width="150"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastPlayedText}" FontSize="12" Foreground="{DynamicResource AppMuted}" Margin="0,3,0,0"/></StackPanel>
           </StackPanel>
          </Button>
          <Button Grid.Column="2" Content="Play" Style="{StaticResource PrimaryButton}" Click="CardPlayClicked" Height="34" MinHeight="34" Padding="14,0" VerticalAlignment="Center" AutomationProperties.Name="Play"/>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <Grid Grid.Row="2" Margin="0,0,0,18">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
        <RadioButton x:Name="GridModeButton" GroupName="LibraryMode" IsChecked="True" Style="{StaticResource ChipRadio}" Margin="0,0,6,0" Checked="LibraryModeChanged" ToolTip="Cover grid" AutomationProperties.Name="Cover grid"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="{x:Null}" IsHitTestVisible="False" Data="M 1 1 L 6 1 L 6 6 L 1 6 Z M 8 1 L 13 1 L 13 6 L 8 6 Z M 1 8 L 6 8 L 6 13 L 1 13 Z M 8 8 L 13 8 L 13 13 L 8 13 Z"/></RadioButton>
        <RadioButton x:Name="ListModeButton" GroupName="LibraryMode" Style="{StaticResource ChipRadio}" Margin="0" Checked="LibraryModeChanged" ToolTip="Compact list" AutomationProperties.Name="Compact list"><Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="{x:Null}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Data="M 1 3 L 13 3 M 1 7 L 13 7 M 1 11 L 13 11"/></RadioButton>
       </StackPanel>
       <Grid DockPanel.Dock="Left" Width="300" VerticalAlignment="Center"><TextBox x:Name="Search" Height="40" Padding="38,0,12,0" VerticalContentAlignment="Center" TextChanged="FilterChanged" AutomationProperties.Name="Search games" ToolTip="Search your library by game name (press / to jump here)"/>
        <Path Width="14" Height="14" Margin="14,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource AppMuted}" StrokeThickness="1.5" Fill="{x:Null}" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 6 1 A 5 5 0 1 0 6 11 A 5 5 0 1 0 6 1 M 10 10 L 13.5 13.5"/>
        <TextBlock Text="Search games" Margin="38,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
       <WrapPanel x:Name="ChipsPanel" Margin="18,0,0,0" VerticalAlignment="Center">
        <RadioButton x:Name="ChipAll" GroupName="StatusChips" IsChecked="True" Tag="All" Content="All" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="Playing" Content="Playing" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="Completed" Content="Completed" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="OnHold" Content="On hold" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <RadioButton GroupName="StatusChips" Tag="NotStarted" Content="Not started" Style="{StaticResource ChipRadio}" Checked="StatusChipChecked"/>
        <ToggleButton x:Name="ChipRemoved" Content="Removed" Style="{StaticResource ChipToggle}" Checked="RemovedChipChanged" Unchecked="RemovedChipChanged" ToolTip="Show removed games (their data is kept)"/>
        <Button x:Name="TagsButton" Content="Tags ▾" Style="{StaticResource ChipButton}" Click="TagsButtonClicked" Visibility="Collapsed" ToolTip="Filter by tag or category" AutomationProperties.Name="Filter by tags"/>
        <Button x:Name="SortButton" Content="Sort: Name ▾" Style="{StaticResource ChipButton}" Click="SortButtonClicked" ToolTip="Sort order" AutomationProperties.Name="Sort order"/>
        <Button x:Name="ViewsButton" Content="Views ▾" Style="{StaticResource ChipButton}" Click="ViewsButtonClicked" ToolTip="Saved filter views" AutomationProperties.Name="Saved views"/>
       </WrapPanel>
      </DockPanel>
      <StackPanel Visibility="Collapsed"><ComboBox x:Name="StatusFilter" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Game status"><ComboBoxItem Content="All statuses" Tag="All"/><ComboBoxItem Content="Not started" Tag="NotStarted"/><ComboBoxItem Content="Playing" Tag="Playing"/><ComboBoxItem Content="Completed" Tag="Completed"/><ComboBoxItem Content="On hold" Tag="OnHold"/></ComboBox><CheckBox x:Name="RemovedFilter" Content="Removed games" Checked="FilterChanged" Unchecked="FilterChanged"/></StackPanel>
     </Grid>
     <Grid Grid.Row="3"><ListBox x:Name="GameList" SelectionChanged="SelectedGameChanged" PreviewKeyDown="LibraryKeyDown" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Game library">
      <ListBox.ItemsPanel><ItemsPanelTemplate><local:VirtualizingCoverPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.Resources>
