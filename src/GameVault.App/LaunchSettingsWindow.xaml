<UserControl x:Class="GameVault.App.LaunchSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameVault.App" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Launch settings" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="GameTitle" FontSize="18" Margin="0,8,0,20" TextWrapping="Wrap" />
                <StackPanel x:Name="Fields">
                    <CheckBox x:Name="UseLaunchExecutable" local:SettingHelp.Text="GameVault detects Steam and Epic installations and starts them through their client. Playtime starts when the game itself is detected. If tracking stops while your game is still running, turn this off and choose the actual game executable below. Store clients may show sign-in or update prompts." Content="Choose the game process automatically" IsChecked="True" Checked="TrackingChoiceChanged" Unchecked="TrackingChoiceChanged" Margin="0,0,0,12" />
                    
                    <Label Content="_Actual game executable (.exe)" Target="{Binding ElementName=TargetPath}" />
                    <DockPanel x:Name="TargetFields" IsEnabled="False"><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseTarget" Margin="8,0,0,0" AutomationProperties.Name="Browse actual game executable" /><TextBox x:Name="TargetPath" TextWrapping="Wrap" AutomationProperties.Name="Actual game executable path" /></DockPanel>
                    <TextBlock Text="Play actions" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12" HorizontalAlignment="Left" local:SettingHelp.Text="Other ways to start this game, such as another version, a mod manager or a launcher. The default action is what the Play button runs; the others are in the menu next to it. Arguments are passed as plain text, not through a shell. Playtime and backups still follow the game process above." />
                    
                    <RadioButton x:Name="NoDefaultAction" GroupName="DefaultAction" Content="No default action" local:SettingHelp.Text="Play starts the game itself." IsChecked="True" Margin="0,0,0,12" />
                    <StackPanel x:Name="ActionsHost" />
                    <Button x:Name="AddActionButton" Content="Add play action" Click="AddAction" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <TextBlock Text="Before launch and after exit" FontSize="20" FontWeight="SemiBold" Margin="0,32,0,12" HorizontalAlignment="Left" local:SettingHelp.Text="Optional programs GameVault runs for this game only: for example start a mod manager first, or close a helper afterwards. Leave the program empty to run nothing. A hook that fails or times out is reported and never stops the game or playtime tracking." />
                    
                    <StackPanel x:Name="HooksHost" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock x:Name="Notice" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" Click="CancelEditing" Margin="0,0,8,0" /><Button x:Name="SaveButton" Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings" /></StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
