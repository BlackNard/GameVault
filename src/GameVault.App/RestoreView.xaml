<UserControl x:Class="GameVault.App.RestoreView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameVault.App" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Fields">
   <TextBlock x:Name="Heading" Text="Restore saved progress" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SelectedIdentity" TextWrapping="Wrap" Margin="0,8,0,16" Foreground="{DynamicResource AppMuted}"/>
   <Border Background="{DynamicResource AppSurface}" CornerRadius="10" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="Your current saves will be preserved first" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" local:SettingHelp.Text="A verified recovery copy is kept outside ordinary backup retention. You can undo the restore from Backups, including after restarting GameVault."/><TextBlock Text="The game must be closed." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,8,0,0"/></StackPanel></Border>
   <TextBlock Text="Restore destinations" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" HorizontalAlignment="Left" local:SettingHelp.Text="Review each path. You can choose new locations after moving or reinstalling a game. These choices apply to this restore; use Save sources to change future backup locations."/>
   <ItemsControl x:Name="Mappings"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><DockPanel Margin="0,6,0,0"><Button Content="Browse…" DockPanel.Dock="Right" Click="BrowseDestination" Margin="8,0,0,0"/><TextBox Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="InputsChanged" AutomationProperties.Name="Restore destination"/></DockPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button x:Name="PreviewButton" Content="Preview file changes" Click="PreviewChanges" HorizontalAlignment="Left" Margin="0,4,0,12"/>
   <TextBlock x:Name="PreviewSummary" Text="Review destinations, then preview the changes before restoring." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,0,0,10"/>
   <ListBox x:Name="Changes" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource AppSurface}" AutomationProperties.Name="Planned restore changes"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}"/><TextBlock Text="{Binding TargetPath}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Expander Header="Other destination files" IsExpanded="True" Margin="0,14,0,12"><StackPanel><TextBlock Text="Unrecognized files are kept. Select a file only if you want it removed, then preview again. Its current contents will also be preserved in recovery." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,8,0,8"/><ItemsControl x:Name="Extras"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Remove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="InputsChanged" Margin="0,4"><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
   <CheckBox x:Name="Confirm" Content="I reviewed the selected copy, destinations and file changes." Checked="ConfirmationChanged" Unchecked="ConfirmationChanged" Margin="0,8,0,12"/>
   <WrapPanel><Button x:Name="RestoreButton" Content="Restore these saves" Style="{StaticResource PrimaryButton}" Click="RestoreSaves" Margin="0,0,10,12"/><Button x:Name="UndoButton" Content="Preview undo" Click="PreviewUndo" Visibility="Collapsed" Margin="0,0,0,12"/></WrapPanel>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="1" Margin="0,12,0,0"><Button x:Name="BackButton" Content="Back to backups" DockPanel.Dock="Right" Click="Back"/><Button x:Name="CancelButton" Content="Cancel operation" DockPanel.Dock="Right" Click="Cancel" Visibility="Collapsed" Margin="0,0,8,0"/><TextBox x:Name="Notice" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Restore result" Margin="0,0,12,0"/></DockPanel>
 </Grid>
</UserControl>