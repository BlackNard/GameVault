<UserControl x:Class="GameVault.App.BackupsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameVault.App" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,12"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12.5"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,14">
     <Button local:SettingHelp.Text="Reads the backup history again." x:Name="RefreshButton" Content="Refresh" DockPanel.Dock="Right" Click="RefreshHistory" VerticalAlignment="Top" Height="36" MinWidth="100" Margin="16,0,0,0"/>
     <StackPanel>
      <TextBlock x:Name="Heading" local:SettingHelp.Text="Revisit your save history. Dates show when copies were made, not progress in the game." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
      
      <TextBlock x:Name="StorageSummary" TextWrapping="Wrap" Foreground="{DynamicResource AppAccent}" FontWeight="SemiBold"/>
     </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
     <StackPanel>
      <DockPanel>
       <Button local:SettingHelp.Text="Saves this rule and removes older unpinned copies, after safety checks." x:Name="ApplyButton" Content="Apply retention" Click="ApplyRetention" DockPanel.Dock="Right" Height="36" VerticalAlignment="Center" Margin="16,0,0,0"/>
       <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Retention for this game" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
        <Label Content="_Keep newest" Target="{Binding ElementName=Limit}" VerticalAlignment="Center" Padding="0,0,8,0"/>
        <TextBox x:Name="Limit" local:SettingHelp.Text="How many unpinned copies to keep. Pinned copies are always kept as well." Width="64" Height="36" Padding="0" Text="20" TextAlignment="Center" TextChanged="DraftChanged" VerticalContentAlignment="Center" AutomationProperties.Name="Unpinned backup limit"/>
        <TextBlock Text="unpinned copies" local:SettingHelp.Text="Pinned copies are always kept as well." VerticalAlignment="Center" Margin="8,0,24,0"/>
        <CheckBox local:SettingHelp.Text="No completed copy is removed." x:Name="KeepEverything" Content="Keep everything" Checked="DraftChanged" Unchecked="DraftChanged" VerticalAlignment="Center"/>
       </WrapPanel>
      </DockPanel>
      <TextBlock x:Name="RetentionPreview" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>

    <Grid Grid.Row="2">
     <ListBox x:Name="HistoryList" MaxHeight="420" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Completed save backups">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Border BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
           <Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
             <Setter Property="Background" Value="{DynamicResource AppRaised}"/>
             <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="{Binding Date}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,12,0"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding PinState}" Foreground="{DynamicResource AppAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <Border x:Name="EmptyNotice" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top" Padding="24,32">
      <StackPanel HorizontalAlignment="Center">
       <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center"/>
       <TextBlock Text="No completed save backups yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
       <TextBlock Text="Play and save, then exit the game, or use Back up now from your library." Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="470"/>
      </StackPanel>
     </Border>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,10,0,0">
     <DockPanel>
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
       <Button local:SettingHelp.Text="A pinned copy is never removed by the retention rule." x:Name="PinButton" Content="Pin backup" Click="TogglePin" Height="36" Margin="10,0,0,0"/>
       <Button local:SettingHelp.Text="Shows what would change before anything is restored." x:Name="RestoreButton" Content="Restore selected…" Click="RestoreSelected" Height="36" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"/>
       <Button local:SettingHelp.Text="Opens the folder of the selected copy." Content="Open backup folder" Click="OpenSelectedFolder" Height="36" Margin="10,0,0,0"/>
      </WrapPanel>
      <TextBlock x:Name="SelectedInfo" Text="Select a backup to keep it beyond the retention limit." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
     </DockPanel>
     <Border x:Name="RecoveryPanel" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,10,0,0">
      <StackPanel>
       <TextBlock Text="Pre-restore recovery copies" FontWeight="SemiBold" Margin="0,0,0,8" local:SettingHelp.Text="These copies preserve saves from before a restore and are never removed by ordinary retention."/>
       
       <DockPanel>
        <Button local:SettingHelp.Text="Shows how to put back the saves from before a restore." x:Name="UndoButton" Content="Undo using recovery…" DockPanel.Dock="Right" Click="UndoSelected" Height="36" Margin="10,0,0,0"/>
        <ComboBox local:SettingHelp.Text="The saves kept before each restore." x:Name="RecoveryList" Height="36" DisplayMemberPath="Label" SelectionChanged="RecoverySelectionChanged" AutomationProperties.Name="Pre-restore recovery copies"/>
       </DockPanel>
      </StackPanel>
     </Border>
     <TextBox x:Name="Warnings" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppWarning}" AutomationProperties.Name="Backup history warnings" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <DockPanel Grid.Row="1" Margin="0,10,0,0">
   <Button x:Name="BackButton" Content="Back to game" DockPanel.Dock="Right" Click="Back" Height="36"/>
   <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel>
 </Grid>
</UserControl>
