<UserControl x:Class="GameVault.App.NoteExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Export notes &amp; reviews" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20"/>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields">
 <Label Content="_What to export" Target="{Binding ElementName=ScopeChoice}"/><ComboBox x:Name="ScopeChoice" SelectionChanged="ScopeChanged" SelectedIndex="0"><ComboBoxItem x:Name="SelectedScope" Content="Selected saved entry"/><ComboBoxItem Content="All notes and reviews for this game"/><ComboBoxItem Content="Entire library (including removed profiles)"/></ComboBox>
 <Label Content="File _format" Target="{Binding ElementName=FormatChoice}" Margin="0,18,0,0"/><ComboBox x:Name="FormatChoice" SelectedIndex="0"><ComboBoxItem Content="Markdown (.md)"/><ComboBoxItem Content="PDF (.pdf)"/></ComboBox>
 <StackPanel x:Name="Packaging" Margin="0,18,0,0"><TextBlock Text="File organization" Margin="0,0,0,8"/><RadioButton x:Name="CombinedChoice" Content="One combined document" GroupName="Packaging" IsChecked="True" Margin="0,0,0,12"/><RadioButton x:Name="SeparateChoice" Content="A separate file for each entry" GroupName="Packaging"/><TextBlock Text="Separate files use unique names and keep existing exports." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
 <TextBlock x:Name="CountNotice" Foreground="{DynamicResource AppAccent}" TextWrapping="Wrap" Margin="0,20,0,0"/>
 <TextBox x:Name="Warnings" Foreground="{DynamicResource AppWarning}" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
 <CheckBox x:Name="Acknowledge" Visibility="Collapsed" Checked="Acknowledged" Unchecked="Acknowledged" Margin="0,8,0,0"><TextBlock Text="I understand the warnings; export available entries." TextWrapping="Wrap"/></CheckBox>
 <TextBlock Text="Your original notes stay in GameVault. Choose a destination outside the app's folder." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,18,0,0"/>
 <TextBox x:Name="ResultNotice" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="170" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Margin="0,14,0,0" AutomationProperties.Name="Export results" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></ScrollViewer>
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="CloseButton" Content="Close" Click="CloseExport" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="Choose destination…" Style="{StaticResource PrimaryButton}" Click="Export"/></StackPanel>
 </Grid>
</UserControl>
