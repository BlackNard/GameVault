<UserControl x:Class="GameVault.App.GameEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16" MaxWidth="820" HorizontalAlignment="Center" Width="820">
            <TextBlock x:Name="Heading" Text="Add game" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Choose your installed game executable." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="1" MaxWidth="820" HorizontalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Fields" Margin="0,0,12,0">
                <Label Content="_Name" Target="{Binding ElementName=GameName}" /><TextBox x:Name="GameName" MaxLength="240" AutomationProperties.Name="Game name" Margin="0,0,0,16" />
                <Label Content="_Executable (.exe)" Target="{Binding ElementName=Executable}" />
                <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseExecutable" Margin="8,0,0,0" AutomationProperties.Name="Browse game executable" /><TextBox x:Name="Executable" TextWrapping="Wrap" AutomationProperties.Name="Game executable path" /></DockPanel>
                <Label Content="_Working directory" Target="{Binding ElementName=WorkingDirectory}" />
                <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseWorking" Margin="8,0,0,0" AutomationProperties.Name="Browse working directory" /><TextBox x:Name="WorkingDirectory" TextWrapping="Wrap" AutomationProperties.Name="Working directory path" /></DockPanel>
                <TextBlock Text="Defaults to the executable’s folder. A custom folder is kept when you browse to another executable." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,16" />
                <Label Content="_Status" Target="{Binding ElementName=StatusChoice}" />
                <ComboBox x:Name="StatusChoice" SelectedIndex="0" Margin="0,0,0,16" AutomationProperties.Name="Game status">
                    <ComboBoxItem Content="Not started" Tag="NotStarted" /><ComboBoxItem Content="Playing" Tag="Playing" /><ComboBoxItem Content="Completed" Tag="Completed" /><ComboBoxItem Content="On hold" Tag="OnHold" />
                </ComboBox>
                <Label Content="_Cover image (optional)" Target="{Binding ElementName=CoverPath}" />
                <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseCover" Margin="8,0,0,0" AutomationProperties.Name="Browse cover image" /><TextBox x:Name="CoverPath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Cover image path" /></DockPanel>
                <WrapPanel Margin="0,8,0,0"><Button Content="Find artwork online…" Click="FindArtwork" Margin="0,0,10,0" AutomationProperties.Name="Search portrait game covers online" /><Button x:Name="RemoveCoverButton" Content="Remove cover" Click="RemoveCover" AutomationProperties.Name="Remove the cover image" ToolTip="Remove this game's cover. It stays removed until you choose another one." /></WrapPanel>
                <TextBlock Text="PNG or JPEG. A copy is stored in this game’s profile." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,16" />
                <Label Content="_Save locations (optional, one full path per line)" Target="{Binding ElementName=SaveSources}" />
                <TextBox x:Name="SaveSources" AcceptsReturn="True" MinHeight="76" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="Save location paths" />
                <WrapPanel Margin="0,8,0,0"><Button Content="Browse folder…" Click="BrowseSaveFolder" Margin="0,0,8,8" /><Button Content="Browse save file…" Click="BrowseSaveFile" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="Optional manual overrides. Leave these empty for automatic discovery, including folders created during the first session. Choose narrow local save files/folders; linked or overlapping sources are not supported." Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="ArtworkHost" Grid.Row="1" Visibility="Collapsed" />
        <StackPanel x:Name="EditorFooter" Grid.Row="2" Margin="0,16,0,0" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock x:Name="ErrorNotice" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" Click="CancelEditing" Margin="0,0,8,0" /><Button x:Name="SaveButton" Content="Add game" Style="{StaticResource PrimaryButton}" Click="SaveGame" /></StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
