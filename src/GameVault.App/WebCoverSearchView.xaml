<UserControl x:Class="GameVault.App.WebCoverSearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameVault.App" Foreground="{DynamicResource AppText}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Google Images" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Only the entered title is sent to Google; Google and image websites may receive normal browser requests." local:SettingHelp.Text="Shows pictures that fit a cover (at least 600 × 900), each labelled with its size. Click one to see the crop, then confirm. Artwork belongs to its owner. PNG and JPEG downloads up to 12 MB and 16 megapixels." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,8"/>
   <Label Content="_Search title" Target="{Binding ElementName=Query}"/>
   <DockPanel><Button local:SettingHelp.Text="Searches again with this title; only the title is sent." x:Name="SearchButton" Content="Search Google Images" Click="Search" DockPanel.Dock="Right" Margin="8,0,0,0"/><ComboBox local:SettingHelp.Text="Which picture shapes to show." x:Name="FilterChoice" DockPanel.Dock="Right" Width="230" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Which results to show"><ComboBoxItem Content="Cover-shaped images (2:3)"/><ComboBoxItem Content="Any portrait that is big enough"/><ComboBoxItem Content="All results"/></ComboBox><TextBox local:SettingHelp.Text="The game title to search for." x:Name="Query" MaxLength="240" KeyDown="QueryKeyDown" AutomationProperties.Name="Google Images search title"/></DockPanel>
   <TextBlock x:Name="Notice" Text="" TextWrapping="Wrap" Margin="0,10" Foreground="{DynamicResource AppWarning}" AutomationProperties.LiveSetting="Polite"/>
   <Border BorderBrush="{DynamicResource AppMuted}" BorderThickness="1" Padding="10" Margin="0,0,0,8"><DockPanel><Button local:SettingHelp.Text="Shows the crop before you use it." x:Name="PreviewButton" Content="Preview selected image" Click="PreviewSelected" IsEnabled="False" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="SelectionNotice" Text="No image selected. Click an image in the search below." TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
   <Button local:SettingHelp.Text="Opens in your browser." x:Name="RuntimeHelp" Content="Open Microsoft's WebView2 Runtime download page" Click="OpenRuntimeHelp" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,8"/>
  </StackPanel>
  <Grid x:Name="BrowserHost" Grid.Row="1" MinHeight="160"/>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Back to covers" Click="Back" Margin="0,0,8,0"/><Button x:Name="BrowserBack" Content="Previous page" Click="PreviousPage" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ReloadButton" Content="Refresh" Click="Reload" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="Cancel download" Click="Stop" IsEnabled="False"/></WrapPanel>
 </Grid>
</UserControl>
