<UserControl x:Class="GameVault.App.NotesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GameVault.App"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <UserControl.Resources>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/><Setter Property="RowBackground" Value="{DynamicResource AppBackground}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource AppSurface}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppLine}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="Foreground" Value="{DynamicResource AppMuted}"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="Padding" Value="4"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AppRaised}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="6"/></Style>
  <Style x:Key="GridTextNoWrap" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="6"/></Style>
 </UserControl.Resources>
 <Grid><Grid x:Name="NotesContent"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid MinHeight="560" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBlock x:Name="GameHeading" Visibility="Collapsed"/>
  <WrapPanel VerticalAlignment="Center"><Button local:SettingHelp.Text="Your play sessions and their notes." x:Name="SessionsTab" Content="Sessions" Click="ShowSessions" Height="40" Margin="0,0,8,0"/><Button local:SettingHelp.Text="Playtime by day, week or month." x:Name="ActivityTab" Content="Activity" Click="ShowActivity" Height="40" Margin="0,0,8,0"/><Button local:SettingHelp.Text="Your review of this game." x:Name="ReviewTab" Content="Review" Click="ShowReview" Height="40" Margin="0,0,8,0" AutomationProperties.Name="Game review"/></WrapPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Label Content="Game status" Target="{Binding ElementName=StatusChoice}" VerticalAlignment="Center" Padding="0,0,8,0"/><ComboBox local:SettingHelp.Text="Where you stand with this game." x:Name="StatusChoice" Width="132" Height="40" VerticalAlignment="Center" SelectionChanged="StatusChanged"/><Button local:SettingHelp.Text="Reads the sessions again." x:Name="RefreshButton" Content="Refresh" Click="RefreshSessions" Height="40" VerticalAlignment="Center" Margin="8,0,0,0"/><Button local:SettingHelp.Text="Saves notes as Markdown, PDF, or into Obsidian." x:Name="ExportButton" Content="Export…" Click="ExportNotes" Height="40" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
 </Grid>
 <Border Grid.Row="1" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
  <UniformGrid Columns="4">
   <StackPanel><TextBlock Text="Total playtime" Foreground="{DynamicResource AppMuted}" FontSize="12"/><TextBlock x:Name="TotalTime" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
   <StackPanel><TextBlock Text="Recorded sessions" Foreground="{DynamicResource AppMuted}" FontSize="12"/><TextBlock x:Name="SessionCount" FontSize="16" FontWeight="SemiBold"/></StackPanel>
   <StackPanel><TextBlock Text="Longest session" Foreground="{DynamicResource AppMuted}" FontSize="12"/><Button x:Name="LongestButton" Click="SelectLongest" Content="None" HorizontalAlignment="Left" FontSize="16" FontWeight="SemiBold" MinHeight="0" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="Select the longest recorded session" AutomationProperties.Name="Select longest session"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" RecognizesAccessKey="True"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AppAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource AppDisabledOpacity}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></StackPanel>
   <StackPanel><TextBlock Text="Last played" Foreground="{DynamicResource AppMuted}" FontSize="12"/><TextBlock x:Name="LastPlayed" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/></StackPanel>
  </UniformGrid>
 </Border>
 <Grid Grid.Row="2">
 <Grid x:Name="Fields"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="2*" MinWidth="380"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
 <DockPanel x:Name="SessionsPane" Margin="0,0,16,0">
  <DockPanel x:Name="TableToolbar" DockPanel.Dock="Top" Margin="0,0,0,8"><ComboBox local:SettingHelp.Text="The order of the sessions." x:Name="SortChoice" DockPanel.Dock="Right" Width="150" Height="40" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Sort session history" SelectionChanged="SortChanged" SelectedIndex="0"><ComboBoxItem Content="Newest first"/><ComboBoxItem Content="Longest first"/><ComboBoxItem Content="Oldest first"/></ComboBox><TextBlock Text="Sessions" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
  <TextBlock x:Name="TimezoneNotice" DockPanel.Dock="Bottom" Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <DataGrid x:Name="SessionList" SelectionChanged="SessionChanged" AutomationProperties.Name="Session history" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="88" ElementStyle="{StaticResource GridTextNoWrap}"/><DataGridTextColumn Header="Time" Binding="{Binding When}" Width="116" ElementStyle="{StaticResource GridTextNoWrap}"/><DataGridTextColumn Header="Played" Binding="{Binding ListDuration}" Width="94" ElementStyle="{StaticResource GridTextNoWrap}"/><DataGridTextColumn Header="Note" Binding="{Binding ListNote}" Width="*" MinWidth="56" ElementStyle="{StaticResource GridText}"/></DataGrid.Columns></DataGrid>
 </DockPanel>
 <Border Grid.Column="1" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="8" Padding="16">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="EntryHeading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel x:Name="RatingPanel" Visibility="Collapsed" Margin="0,8,0,2"><local:StarRatingControl x:Name="Rating" HorizontalAlignment="Left"/><TextBlock x:Name="RatingStatus" Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel><TextBlock x:Name="EntryContext" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/></StackPanel>
 <DockPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="CorrectButton" DockPanel.Dock="Right" ToolTipService.ShowOnDisabled="True" ToolTip="Corrections require a verified finished session and no active game tracking. Interrupted, unknown, or protected records stay unchanged." Content="Correct time…" Click="BeginCorrection"/><StackPanel Orientation="Horizontal"><Button local:SettingHelp.Text="Shows the note as text." x:Name="ReadButton" Content="Read" Click="ReadNote" Margin="0,0,6,0"/><Button local:SettingHelp.Text="Lets you change the note." x:Name="EditButton" Content="Edit" Click="EditNote"/></StackPanel></DockPanel>
 <Grid Grid.Row="2"><Grid x:Name="EditPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Label Content="Title (optional)" Target="{Binding ElementName=NoteTitle}"/><TextBox local:SettingHelp.Text="A short title. Optional." x:Name="NoteTitle" MaxLength="2000" TextChanged="DraftChanged"/></DockPanel><TextBox x:Name="NoteBody" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" AutomationProperties.Name="Session note text"/></Grid>
 <Grid x:Name="ReadPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ReadTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox x:Name="ReadBody" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0" Background="Transparent" AutomationProperties.Name="Note reading view"/></Grid></Grid>
 <DockPanel Grid.Row="3" Margin="0,10,0,0"><Button x:Name="SaveButton" local:SettingHelp.Text="Ctrl+S also saves. Notes and original measurements stay in this game's profile." DockPanel.Dock="Right" Content="Save note" Style="{StaticResource PrimaryButton}" Click="SaveNote" Margin="12,0,0,0"/><TextBlock x:Name="SaveStatus" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </Grid></Border></Grid>
 <ScrollViewer x:Name="ActivityPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><UniformGrid Columns="3" Margin="0,8,0,18"><StackPanel><TextBlock Text="Today"/><TextBlock x:Name="TodayTime" FontSize="18"/></StackPanel><StackPanel><TextBlock Text="This week (Monday)"/><TextBlock x:Name="WeekTime" FontSize="18"/></StackPanel><StackPanel><TextBlock Text="This month"/><TextBlock x:Name="MonthTime" FontSize="18"/></StackPanel></UniformGrid><DockPanel Margin="0,0,0,10"><ComboBox local:SettingHelp.Text="How playtime is grouped." x:Name="GroupChoice" DockPanel.Dock="Right" Width="150" SelectedIndex="0" SelectionChanged="GroupChanged"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/><ComboBoxItem Content="Monthly"/></ComboBox><TextBlock Text="Activity breakdown" FontSize="20"/></DockPanel><DataGrid x:Name="ActivityList" MaxHeight="240" AutomationProperties.Name="Activity by date"><DataGrid.Columns><DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="*" ElementStyle="{StaticResource GridText}"/><DataGridTextColumn Header="Playing time" Binding="{Binding Duration}" Width="*" ElementStyle="{StaticResource GridText}"/></DataGrid.Columns></DataGrid><TextBlock x:Name="ActivityExplanation" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,12,0,14"/><TextBlock Text="Correction history" FontSize="20" Margin="0,0,0,8"/><TextBox x:Name="CorrectionHistory" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" MaxHeight="220" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Correction audit history"/></StackPanel></ScrollViewer>
 <Border x:Name="CorrectionPanel" Visibility="Collapsed" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Correct this session's playing time" FontSize="20" TextWrapping="Wrap"/><TextBlock x:Name="CorrectionContext" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/><UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><Label Content="Hours" Target="{Binding ElementName=CorrectionHours}"/><TextBox x:Name="CorrectionHours" TextChanged="CorrectionEdited"/></StackPanel><StackPanel Margin="0,0,8,0"><Label Content="Minutes" Target="{Binding ElementName=CorrectionMinutes}"/><TextBox x:Name="CorrectionMinutes" TextChanged="CorrectionEdited"/></StackPanel><StackPanel><Label Content="Seconds" Target="{Binding ElementName=CorrectionSeconds}"/><TextBox x:Name="CorrectionSeconds" TextChanged="CorrectionEdited"/></StackPanel></UniformGrid><Label Content="Reason" Target="{Binding ElementName=CorrectionReason}" Margin="0,12,0,0"/><TextBox local:SettingHelp.Text="Why you are correcting the time." x:Name="CorrectionReason" TextChanged="CorrectionEdited" MaxLength="2000"/><TextBlock x:Name="CorrectionNotice" TextWrapping="Wrap" Foreground="{DynamicResource AppWarning}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CancelCorrectionButton" Content="Cancel" Click="CancelCorrection" Margin="0,0,8,0"/><Button x:Name="SaveCorrectionButton" Content="Save correction" Style="{StaticResource PrimaryButton}" Click="SaveCorrection"/></StackPanel></StackPanel></ScrollViewer></Border>
 </Grid>
 <TextBox x:Name="Warnings" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AppWarning}" MaxHeight="62" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="History warnings"/>

 </Grid></ScrollViewer>
 <DockPanel Grid.Row="1" Margin="0,12,0,0"><Button x:Name="BackButton" DockPanel.Dock="Right" Content="Back to game" Click="BackToLibrary"/><TextBlock x:Name="TrackingNotice" Text="" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid><ContentControl x:Name="ExportHost" Visibility="Collapsed"/></Grid>
</UserControl>
