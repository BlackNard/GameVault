    <Style TargetType="Expander">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" HorizontalContentAlignment="Left" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Chevron" Text="â€º" FontSize="18" Margin="0,0,8,0"/>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="8"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="Text" Value="âŒ„"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
