<UserControl x:Class="GameVault.App.CoverSearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource AppText}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <TextBlock Text="Choose cover artwork" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Open an image search in your browser, save artwork you may use, then choose that image here. Only the title below is sent when you click Search; no account or key is needed." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,8"/>
  <Label Content="_Search title" Target="{Binding ElementName=Query}"/>
  <DockPanel><Button Content="Search images in browser" Click="Search" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Query" MaxLength="240" AutomationProperties.Name="Image search title" KeyDown="QueryKeyDown"/></DockPanel>
  <TextBlock x:Name="Notice" Text="Choose a static PNG or JPEG, up to 12 MB and 16 megapixels." TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource AppWarning}" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
 <Border Grid.Row="1" AllowDrop="True" DragOver="DragOverImage" Drop="DropImage" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="6" Padding="16" MinHeight="160">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Drop one PNG or JPEG here, or choose Browse image." TextWrapping="Wrap" HorizontalAlignment="Center"/><Image x:Name="Preview" Grid.Row="1" MaxHeight="420" MaxWidth="360" Stretch="Uniform" Margin="0,12,0,0" AutomationProperties.Name="Unconfirmed cover preview"/></Grid>
 </Border>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="BackButton" Content="Back" Click="Back" Margin="0,0,8,8"/><Button x:Name="BrowseButton" Content="Browse image…" Click="Browse" Margin="0,0,8,8"/><Button x:Name="UseButton" Content="Use this cover" Click="UseCover" IsEnabled="False" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
 </Grid>
</UserControl>
