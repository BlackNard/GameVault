<UserControl x:Class="GameVault.App.CoverSearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource AppText}">
 <Grid><Grid x:Name="NativeContent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <TextBlock Text="Choose cover artwork" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Search Steam's game catalogue for portrait covers. Only the title you enter is sent; no account or key is needed. Coverage varies. Large images are center cropped to fill the portrait frame; check the preview before confirming. Browse or drop your own image anytime." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,8"/>
  <Label Content="_Search title" Target="{Binding ElementName=Query}"/>
  <DockPanel><Button x:Name="SearchButton" Content="Search covers" Click="Search" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="Search Google Images" Click="SearchWeb" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="StopButton" Content="Cancel loading" Click="Stop" DockPanel.Dock="Right" Margin="8,0,0,0" IsEnabled="False"/><TextBox x:Name="Query" MaxLength="240" AutomationProperties.Name="Cover search title" KeyDown="QueryKeyDown" TextChanged="QueryChanged"/></DockPanel>
  <TextBlock x:Name="Notice" Text="Enter a game title and choose Search covers. PNG and JPEG imports: up to 12 MB and 16 megapixels." TextWrapping="Wrap" Margin="0,10" Foreground="{DynamicResource AppWarning}" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
 <Grid Grid.Row="1" AllowDrop="True" DragOver="DragOverImage" Drop="DropImage" MinHeight="160"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <ListBox x:Name="Gallery" ItemsSource="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectionChanged="SelectionChanged" Background="Transparent" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppLine}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Matching portrait covers">
   <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Thumbnail}" Width="80" Height="120" Stretch="Uniform"/><StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Context}" TextWrapping="Wrap"/><TextBlock Text="{Binding Dimensions}" Foreground="{DynamicResource AppMuted}"/><TextBlock Text="Steam · publisher artwork" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"/><TextBlock Text="{Binding SourcePage}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="6" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="Preview" MaxHeight="420" Stretch="Uniform" AutomationProperties.Name="Unconfirmed cover preview"/><TextBlock x:Name="PreviewDetails" Grid.Row="1" Text="Select a cover to preview, or drop one PNG or JPEG here." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource AppMuted}"/></Grid></Border>
 </Grid>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="BackButton" Content="Back" Click="Back" Margin="0,0,8,8"/><Button x:Name="BrowseButton" Content="Browse image…" Click="Browse" Margin="0,0,8,8"/><Button x:Name="UseButton" Content="Use this cover" Click="UseCover" IsEnabled="False" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
 </Grid><ContentControl x:Name="WebHost" Visibility="Collapsed"/></Grid>
</UserControl>
